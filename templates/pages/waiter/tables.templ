package waiter

import (
	"fmt"
	"strconv"
	waiterservice "restaurant_network_pos/internal/service/waiter"
)

templ TablesPage(tables []waiterservice.TableView, restaurantName string) {
	<div class="p-6 max-w-6xl mx-auto fade-in">
		<!-- Header -->
		<div class="mb-6">
			<h1 class="text-xl font-semibold text-slate-900">План залу</h1>
			<p class="text-slate-500 text-sm mt-0.5">Ресторан { restaurantName }</p>
		</div>
		<!-- Legend -->
		<div class="flex gap-4 mb-5 flex-wrap">
			<div class="flex items-center gap-1.5 text-xs text-slate-500">
				<span class="w-2.5 h-2.5 rounded-full bg-green-400 inline-block"></span>
				Вільний — натисніть, щоб створити замовлення
			</div>
			<div class="flex items-center gap-1.5 text-xs text-slate-500">
				<span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block"></span>
				Зайнятий — натисніть, щоб додати позиції
			</div>
		</div>
		<!-- Grid -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
			for _, t := range tables {
				@tableCard(t)
			}
		</div>
		<!-- Floating action button (injected by JS) -->
		<div id="tableAction"></div>
	</div>
	<script>
		var selectedTable = null;
		var selectedStatus = null;

		function selectTable(number, status) {
			if (selectedTable === number) {
				selectedTable = null;
				selectedStatus = null;
			} else {
				selectedTable = number;
				selectedStatus = status;
			}
			renderTableSelection();
		}

		function renderTableSelection() {
			document.querySelectorAll('.table-card').forEach(function(el) {
				el.classList.remove('ring-2', 'ring-blue-500', 'scale-105', 'shadow-xl', 'z-10');
			});

			var actionEl = document.getElementById('tableAction');
			if (!selectedTable) {
				actionEl.innerHTML = '';
				return;
			}

			var card = document.getElementById('table-card-' + selectedTable);
			if (card) card.classList.add('ring-2', 'ring-blue-500', 'scale-105', 'shadow-xl', 'z-10');

			var isOccupied = selectedStatus === 'occupied';
			var btnText  = isOccupied ? 'Дозамовити' : 'Зробити замовлення';
			var bgClass  = isOccupied ? 'bg-blue-600 hover:bg-blue-500' : 'bg-green-600 hover:bg-green-500';
			var url      = '/waiter/tables/' + selectedTable + '/menu';

			actionEl.innerHTML =
				'<div class="fixed bottom-8 left-56 right-0 flex justify-center z-50 pointer-events-none">' +
				'<a href="' + url + '" class="pointer-events-auto shadow-2xl px-10 py-3.5 ' + bgClass + ' text-white font-semibold rounded-2xl text-base transition-all hover:-translate-y-1 slide-up">' +
				btnText + '</a></div>';
		}
	</script>
}

templ tableCard(t waiterservice.TableView) {
	if t.Status == "free" {
		<div
			id={ fmt.Sprintf("table-card-%d", t.Number) }
			onclick={ templ.ComponentScript{Call: fmt.Sprintf("selectTable(%d,'free')", t.Number)} }
			class="table-card relative border-2 border-green-400 bg-green-50 rounded-2xl p-4 cursor-pointer transition-all duration-150 hover:shadow-xl hover:-translate-y-1 select-none"
		>
			@tableCardContent(t)
		</div>
	} else {
		<div
			id={ fmt.Sprintf("table-card-%d", t.Number) }
			onclick={ templ.ComponentScript{Call: fmt.Sprintf("selectTable(%d,'occupied')", t.Number)} }
			class="table-card relative border-2 border-red-300 bg-red-50 rounded-2xl p-4 cursor-pointer transition-all duration-150 hover:shadow-xl hover:-translate-y-1 select-none"
		>
			@tableCardContent(t)
		</div>
	}
}

templ tableCardContent(t waiterservice.TableView) {
	<div class="flex items-start justify-between mb-3">
		<span class="text-[1.75rem] font-bold text-slate-700 mono leading-none">№{ strconv.Itoa(t.Number) }</span>
		if t.Status == "free" {
			<span class="w-2.5 h-2.5 rounded-full bg-green-400 mt-1 flex-shrink-0"></span>
		} else {
			<span class="w-2.5 h-2.5 rounded-full bg-red-400 mt-1 flex-shrink-0"></span>
		}
	</div>
	<div class="text-sm text-slate-400 mb-1.5">{ strconv.Itoa(t.Capacity) } місця</div>
	if t.Status == "free" {
		<div class="text-xs font-medium text-green-700">Натисніть для замовлення</div>
	} else {
		<div class="text-xs font-medium text-slate-600">Зайнятий</div>
		if t.SeatTime != "" {
			<div class="mt-2 pt-2 border-t border-slate-200/70 text-xs text-slate-500 font-medium">
				Час посадки: <span class="mono font-bold">{ t.SeatTime }</span>
			</div>
		}
	}
}
