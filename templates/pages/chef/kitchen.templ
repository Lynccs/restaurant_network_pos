package chefpages

import (
	"fmt"
	"sort"
	"strconv"
	"strings"
	"time"

	chefservice "restaurant_network_pos/internal/service/chef"
)

// isTaskCookingOverdue повертає true якщо кухар вже готує довше за норму страви.
func isTaskCookingOverdue(task chefservice.KitchenTaskView) bool {
	if task.Status != chefservice.TaskStatusCooking || task.StartTime == nil {
		return false
	}
	return time.Since(*task.StartTime) >= time.Duration(task.CookingTime)*time.Minute
}

// ticketDominantStatus визначає «домінуючий» статус тікета для JS-фільтрації.
func ticketDominantStatus(ticket chefservice.KitchenTicket) string {
	if ticket.IsOverdue {
		return "overdue"
	}
	hasCooking, hasNew := false, false
	for _, t := range ticket.Tasks {
		switch t.Status {
		case chefservice.TaskStatusCooking:
			hasCooking = true
		case chefservice.TaskStatusNew:
			hasNew = true
		}
	}
	if hasCooking {
		return "cooking"
	}
	if hasNew {
		return "new"
	}
	return "ready"
}

// collectFilterOptions збирає унікальні відсортовані назви страв з тікетів.
// Список кухарів береться з allChefs (всі кухарі ресторану з БД).
// Поточний кухар (currentChefID) повертається окремо і не входить до списку chefs.
func collectFilterOptions(tickets []chefservice.KitchenTicket, allChefs []chefservice.ChefInfo, currentChefID int) (dishes []string, chefs []string, currentChefName string) {
	dishSeen := map[string]bool{}
	for _, t := range tickets {
		for _, task := range t.Tasks {
			if !dishSeen[task.DishName] {
				dishSeen[task.DishName] = true
				dishes = append(dishes, task.DishName)
			}
		}
	}
	sort.Strings(dishes)
	for _, c := range allChefs {
		if c.ID == currentChefID {
			currentChefName = c.Name
		} else {
			chefs = append(chefs, c.Name)
		}
	}
	return
}

// KitchenBoard — основний компонент KDS-монітора.
// Використовується і для повного рендеру сторінки (через ChefLayout),
// і як HTMX-фрагмент при поллінгу або після дій кухаря.
templ KitchenBoard(tickets []chefservice.KitchenTicket, currentChefID int, allChefs []chefservice.ChefInfo) {
	<div
		id="kitchen-board"
		class="flex-1 flex flex-col bg-slate-800 p-4 overflow-hidden"
		hx-get="/chef/kitchen/board"
		hx-trigger="sse-refresh"
		hx-swap="outerHTML"
	>
		<!-- Заголовок -->
		<div class="flex items-start justify-between mb-4 flex-shrink-0">
			<div>
				<h1 class="text-xl font-semibold text-white">Термінал кухаря (KDS)</h1>
				<p class="text-slate-400 text-sm mt-0.5">Керування приготуванням страв</p>
			</div>
			<div class="text-slate-500 text-xs mono mt-1 text-right">
					<span id="kds-clock"></span>
				</div>
		</div>
		<!-- Фільтри -->
		{{ dishes, chefs, currentChefName := collectFilterOptions(tickets, allChefs, currentChefID) }}
		<div id="kds-filter-bar" class="bg-slate-700/40 border border-slate-600 rounded-xl p-3 mb-4 flex-shrink-0">
			<div class="flex flex-wrap items-center gap-2">
				<!-- Статус -->
				<select
					id="kds-filter-status"
					onchange="kdsSetFilter('status',this.value)"
					class="w-[135px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Активні</option>
					<option value="new">Нові</option>
					<option value="overdue">Протерміновані</option>
					<option value="cooking">Готуються</option>
					<option value="ready">Готові</option>
				</select>
				<!-- № столу -->
				<input
					id="kds-filter-table"
					type="number"
					min="1"
					placeholder="№ столу"
					oninput="kdsSetFilter('table',this.value)"
					onkeydown="if(event.key==='-'||event.key==='e'||event.key==='E'||event.key==='+')event.preventDefault()"
					class="w-[80px] border border-slate-500 bg-slate-700 text-slate-100 placeholder-slate-400 rounded-lg px-2 py-1.5 text-sm"
				/>
				<!-- Кухар -->
				<select
					id="kds-filter-chef"
					onchange="kdsSetFilter('chef',this.value)"
					class="border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Усі кухарі</option>
					if currentChefName != "" {
						<option value={ currentChefName }>Ви</option>
					}
					for _, chef := range chefs {
						<option value={ chef }>{ chef }</option>
					}
				</select>
				<!-- Цех -->
				<select
					id="kds-filter-workshop"
					onchange="kdsSetFilter('workshop',this.value)"
					class="w-[93px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Усі цехи</option>
					<option value="Гарячий">Гарячий</option>
					<option value="Холодний">Холодний</option>
					<option value="Закуски">Закуски</option>
				</select>
				<!-- Страва -->
				<select
					id="kds-filter-dish"
					onchange="kdsSetFilter('dish',this.value)"
					class="border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Усі страви</option>
					for _, dish := range dishes {
						<option value={ dish }>{ dish }</option>
					}
				</select>
				<!-- Час від -->
				<div class="flex items-center gap-1">
					<span class="text-slate-400 text-sm">З</span>
					<input
						id="kds-filter-from"
						type="time"
						title="Час від"
						onchange="kdsSetFilter('from',this.value)"
						class="w-[86px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-1.5 py-1.5 text-sm"
					/>
				</div>
				<!-- Час до + Очистити -->
				<div class="flex items-center gap-1">
					<span class="text-slate-400 text-sm">До</span>
					<input
						id="kds-filter-to"
						type="time"
						title="Час до"
						onchange="kdsSetFilter('to',this.value)"
						class="w-[86px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-1.5 py-1.5 text-sm"
					/>
				</div>
				<button
					onclick="kdsClearFilters()"
					class="px-3 py-1.5 border border-slate-500 text-slate-200 rounded-lg text-sm hover:bg-slate-600 transition-colors"
				>
					Очистити
				</button>
				<!-- Дата готових (показується лише при статусі "Готові") -->
				<div id="kds-ready-date-row" style="display:none;" class="flex items-center gap-2">
					<span class="text-slate-400 text-sm">Дата:</span>
					<input
						id="kds-filter-ready-date"
						name="date"
						type="date"
						hx-get="/chef/kitchen/board/ready"
						hx-target="#kitchen-board"
						hx-swap="outerHTML"
						hx-trigger="change, ready-load"
						class="w-[118px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-1.5 py-1.5 text-sm"
					/>
				</div>
			</div>
		</div>
		<!-- Колонки-тікети -->
		<div class="flex-1 flex gap-5 overflow-x-auto overflow-y-hidden flex-nowrap pb-2 scrollbar-thin">
			if len(tickets) == 0 {
				<div class="flex-1 flex items-center justify-center">
					<p class="text-slate-500 text-sm">Немає активних замовлень</p>
				</div>
			}
			if len(tickets) > 0 {
				<div id="kds-no-results" style="display:none;" class="flex-1 flex items-center justify-center">
					<p class="text-slate-500 text-sm">Немає замовлень за вибраними фільтрами</p>
				</div>
			}
			for _, ticket := range tickets {
				@TicketCol(ticket, currentChefID)
			}
		</div>
	</div>
}

// TicketCol — вертикальна колонка одного замовлення.
templ TicketCol(ticket chefservice.KitchenTicket, currentChefID int) {
	<div
		id={ fmt.Sprintf("ticket-%d", ticket.OrderID) }
		data-ticket-status={ ticketDominantStatus(ticket) }
		data-table={ fmt.Sprintf("%d", ticket.TableNumber) }
		data-overdue={ fmt.Sprintf("%v", ticket.IsOverdue) }
		data-created-ms={ fmt.Sprintf("%d", ticket.CreatedAt.UnixMilli()) }
		class={
		"w-80 flex-shrink-0 rounded-xl flex flex-col shadow-xl overflow-hidden h-full max-h-full",
		templ.KV("bg-red-50 ring-2 ring-red-400", ticket.IsOverdue),
		templ.KV("bg-slate-100", !ticket.IsOverdue),
	}>
		<!-- Шапка тікета -->
		<div class={
			"px-4 py-3 flex items-center justify-between flex-shrink-0 border-b-4",
			templ.KV("bg-red-600 border-red-700", ticket.IsOverdue),
			templ.KV("bg-slate-900 border-slate-900", !ticket.IsOverdue),
		}>
			<div>
				<div class="font-bold mono text-xl leading-tight text-white">{ ticket.OrderNumber }</div>
				<div class={
					"text-sm font-medium mt-1",
					templ.KV("text-red-100", ticket.IsOverdue),
					templ.KV("text-slate-300", !ticket.IsOverdue),
				}>
					{ fmt.Sprintf("Стіл №%d · %s", ticket.TableNumber, ticket.WaiterName) }
				</div>
			</div>
			<div class={
				"text-sm font-bold mono px-2 py-1 rounded border",
				templ.KV("bg-red-700 text-white border-red-600", ticket.IsOverdue),
				templ.KV("bg-slate-800 text-amber-400 border-slate-700", !ticket.IsOverdue),
			}>
				{ ticket.CreatedAt.Format("15:04") }
			</div>
		</div>
		<!-- Картки страв -->
		<div class="flex-1 overflow-y-auto space-y-3 p-3 scrollbar-thin">
			for _, task := range ticket.Tasks {
				@taskCard(task, ticket.IsOverdue, currentChefID, ticket.OrderID)
			}
		</div>
	</div>
}

// ReadyHistoryBoard — архівна дошка готових страв за конкретну дату.
// Замінює #kitchen-board через HTMX (outerHTML). Без SSE-тригера — статичний перегляд.
templ ReadyHistoryBoard(tickets []chefservice.KitchenTicket, allChefs []chefservice.ChefInfo, date string) {
	{{ dishes, chefs, _ := collectFilterOptions(tickets, allChefs, 0) }}
	<div id="kitchen-board" class="flex-1 flex flex-col bg-slate-800 p-4 overflow-hidden">
		<!-- Заголовок -->
		<div class="flex items-start justify-between mb-4 flex-shrink-0">
			<div>
				<h1 class="text-xl font-semibold text-white">Готові страви</h1>
				<p class="text-slate-400 text-sm mt-0.5">Архів за { date }</p>
			</div>
			<div class="text-slate-500 text-xs mono mt-1 text-right">
				<span id="kds-clock"></span>
			</div>
		</div>
		<!-- Фільтри (такі ж як в KitchenBoard, зі статусом "Готові" і видимою датою) -->
		<div id="kds-filter-bar" class="bg-slate-700/40 border border-slate-600 rounded-xl p-3 mb-4 flex-shrink-0">
			<div class="flex flex-wrap items-center gap-2">
				<select
					id="kds-filter-status"
					onchange="kdsSetFilter('status',this.value)"
					class="w-[102px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Активні</option>
					<option value="new">Нові</option>
					<option value="overdue">Протерміновані</option>
					<option value="cooking">Готуються</option>
					<option value="ready" selected>Готові</option>
				</select>
				<input
					id="kds-filter-table"
					type="number"
					min="1"
					placeholder="№ столу"
					oninput="kdsSetFilter('table',this.value)"
					onkeydown="if(event.key==='-'||event.key==='e'||event.key==='E'||event.key==='+')event.preventDefault()"
					class="w-[80px] border border-slate-500 bg-slate-700 text-slate-100 placeholder-slate-400 rounded-lg px-2 py-1.5 text-sm"
				/>
				<select
					id="kds-filter-chef"
					onchange="kdsSetFilter('chef',this.value)"
					class="border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Усі кухарі</option>
					for _, chef := range chefs {
						<option value={ chef }>{ chef }</option>
					}
				</select>
				<select
					id="kds-filter-workshop"
					onchange="kdsSetFilter('workshop',this.value)"
					class="w-[93px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Усі цехи</option>
					<option value="Гарячий">Гарячий</option>
					<option value="Холодний">Холодний</option>
					<option value="Закуски">Закуски</option>
				</select>
				<select
					id="kds-filter-dish"
					onchange="kdsSetFilter('dish',this.value)"
					class="border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-2 py-1.5 text-sm"
				>
					<option value="all">Усі страви</option>
					for _, dish := range dishes {
						<option value={ dish }>{ dish }</option>
					}
				</select>
				<!-- Час від -->
				<div class="flex items-center gap-1">
					<span class="text-slate-400 text-sm">З</span>
					<input
						id="kds-filter-from"
						type="time"
						title="Час від"
						onchange="kdsSetFilter('from',this.value)"
						class="w-[86px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-1.5 py-1.5 text-sm"
					/>
				</div>
				<!-- Час до -->
				<div class="flex items-center gap-1">
					<span class="text-slate-400 text-sm">До</span>
					<input
						id="kds-filter-to"
						type="time"
						title="Час до"
						onchange="kdsSetFilter('to',this.value)"
						class="w-[86px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-1.5 py-1.5 text-sm"
					/>
				</div>
				<!-- Дата (видима, з поточною датою) -->
				<div id="kds-ready-date-row" style="display:flex;" class="flex items-center gap-2">
					<span class="text-slate-400 text-sm">Дата:</span>
					<input
						id="kds-filter-ready-date"
						name="date"
						type="date"
						value={ date }
						hx-get="/chef/kitchen/board/ready"
						hx-target="#kitchen-board"
						hx-swap="outerHTML"
						hx-trigger="change, ready-load"
						class="w-[118px] border border-slate-500 bg-slate-700 text-slate-100 rounded-lg px-1.5 py-1.5 text-sm"
					/>
				</div>
				<button
					onclick="kdsClearFilters()"
					class="px-3 py-1.5 border border-slate-500 text-slate-200 rounded-lg text-sm hover:bg-slate-600 transition-colors"
				>
					Очистити
				</button>
			</div>
		</div>
		<!-- Колонки тікетів (тільки готові, без кнопок дій) -->
		<div class="flex-1 flex gap-5 overflow-x-auto overflow-y-hidden flex-nowrap pb-2 scrollbar-thin">
			if len(tickets) == 0 {
				<div class="flex-1 flex items-center justify-center">
					<p class="text-slate-500 text-sm">Немає готових страв за цю дату</p>
				</div>
			}
			if len(tickets) > 0 {
				<div id="kds-no-results" style="display:none;" class="flex-1 flex items-center justify-center">
					<p class="text-slate-500 text-sm">Немає замовлень за вибраними фільтрами</p>
				</div>
			}
			for _, ticket := range tickets {
				@readyHistoryTicketCol(ticket)
			}
		</div>
	</div>
}

// readyHistoryTicketCol — тікет в архівному перегляді (всі страви готові, без кнопок дій).
templ readyHistoryTicketCol(ticket chefservice.KitchenTicket) {
	<div
		id={ fmt.Sprintf("ticket-%d", ticket.OrderID) }
		data-ticket-status="ready"
		data-table={ fmt.Sprintf("%d", ticket.TableNumber) }
		data-overdue="false"
		data-created-ms={ fmt.Sprintf("%d", ticket.CreatedAt.UnixMilli()) }
		class="w-80 flex-shrink-0 rounded-xl flex flex-col shadow-xl overflow-hidden h-full max-h-full bg-slate-100"
	>
		<div class="px-4 py-3 flex items-center justify-between flex-shrink-0 border-b-4 bg-slate-900 border-slate-900">
			<div>
				<div class="font-bold mono text-xl leading-tight text-white">{ ticket.OrderNumber }</div>
				<div class="text-sm font-medium mt-1 text-slate-300">
					{ fmt.Sprintf("Стіл №%d · %s", ticket.TableNumber, ticket.WaiterName) }
				</div>
			</div>
			<div class="text-sm font-bold mono px-2 py-1 rounded border bg-slate-800 text-amber-400 border-slate-700">
				{ ticket.CreatedAt.Format("15:04") }
			</div>
		</div>
		<div class="flex-1 overflow-y-auto space-y-3 p-3 scrollbar-thin">
			for _, task := range ticket.Tasks {
				@readyHistoryTaskCard(task)
			}
		</div>
	</div>
}

// readyHistoryTaskCard — картка готової страви з часом завершення.
templ readyHistoryTaskCard(task chefservice.KitchenTaskView) {
	<div
		data-status="ready"
		data-category={ task.DishCategory }
		data-chef={ task.ChefName }
		data-dish={ task.DishName }
		class="dish-card-kds border-2 rounded-xl p-4 shadow-sm flex flex-col fade-in bg-green-50 border-green-200"
	>
		<div class="flex items-start mb-2">
			<div class="bg-slate-200 text-slate-800 px-2 py-1 rounded-md flex items-center gap-0.5 mr-3 flex-shrink-0 shadow-[inset_0_1px_3px_rgba(0,0,0,0.05)] border border-slate-300">
				<span class="text-lg font-bold">{ fmt.Sprintf("%d", task.Qty) }</span>
				<span class="text-xl font-semibold text-slate-500 mt-0.5">&times;</span>
			</div>
			<div class="text-base font-bold text-slate-800 leading-tight pt-1">{ task.DishName }</div>
		</div>
		if task.ChefName != "" {
			<div class="text-[11px] text-slate-500 mb-2">
				Кухар: <span class="font-semibold text-slate-700">{ task.ChefName }</span>
			</div>
		}
		<div class="w-full text-sm font-bold text-center py-2 rounded-lg bg-green-100 text-green-700">
			✓ Готово
		</div>
	</div>
}

// taskCard — картка однієї страви всередині тікета.
templ taskCard(task chefservice.KitchenTaskView, ticketOverdue bool, currentChefID int, orderID int) {
	{{ overdue := isTaskCookingOverdue(task) }}
	<div
		data-status={ string(task.Status) }
		data-category={ task.DishCategory }
		data-chef={ task.ChefName }
		data-dish={ task.DishName }
		class={
		"dish-card-kds border-2 rounded-xl p-4 shadow-sm flex flex-col fade-in",
		templ.KV("bg-green-50 border-green-200 opacity-60", task.Status == chefservice.TaskStatusReady),
		templ.KV("bg-red-100 border-red-500", task.Status == chefservice.TaskStatusCooking && overdue),
		templ.KV("bg-white border-slate-200", task.Status == chefservice.TaskStatusCooking && !overdue),
		templ.KV("bg-red-50 border-red-200", task.Status == chefservice.TaskStatusNew && ticketOverdue),
		templ.KV("bg-white border-slate-200", task.Status == chefservice.TaskStatusNew && !ticketOverdue),
	}>
		<!-- Кількість + назва страви -->
		<div class="flex items-start mb-2">
			<div class="bg-slate-200 text-slate-800 px-2 py-1 rounded-md flex items-center gap-0.5 mr-3 flex-shrink-0 shadow-[inset_0_1px_3px_rgba(0,0,0,0.05)] border border-slate-300">
				<span class="text-lg font-bold">{ fmt.Sprintf("%d", task.Qty) }</span>
				<span class="text-xl font-semibold text-slate-500 mt-0.5">&times;</span>
			</div>
			<div class="text-base font-bold text-slate-800 leading-tight pt-1">{ task.DishName }</div>
		</div>
		<!-- Ім'я кухаря (під час готування та після) -->
		if (task.Status == chefservice.TaskStatusCooking || task.Status == chefservice.TaskStatusReady) && task.ChefName != "" {
			<div class="text-[11px] text-slate-500 mb-2">
				Кухар: <span class="font-semibold text-slate-700">{ task.ChefName }</span>
			</div>
		}
		<!-- Таймер (якщо готується) -->
		if task.Status == chefservice.TaskStatusCooking && task.StartTime != nil {
			<div
				class={
					"kitchen-timer w-full text-xl font-mono font-bold text-center py-2 mb-3 rounded-lg border shadow-sm",
					templ.KV("bg-red-50 text-red-600 border-red-300 border-2", overdue),
					templ.KV("bg-slate-100 text-slate-700 border-slate-200", !overdue),
				}
				data-start={ fmt.Sprintf("%d", task.StartTime.UnixMilli()) }
				data-limit={ fmt.Sprintf("%d", task.CookingTime) }
			>
				00:00
			</div>
		}
		<!-- Бейдж "Готово" -->
		if task.Status == chefservice.TaskStatusReady {
			<div class="w-full text-sm font-bold text-center py-2 mb-3 rounded-lg bg-green-100 text-green-600">
				✓ Готово
			</div>
		}
		<!-- Кнопки дій -->
		if task.Status == chefservice.TaskStatusNew {
			<button
				hx-get={ fmt.Sprintf("/chef/kitchen/tasks/%d/start-modal", task.OrderItemID) }
				hx-target="#chef-modal"
				hx-swap="innerHTML"
				class="w-full bg-amber-400 hover:bg-amber-500 text-amber-900 text-sm font-bold uppercase tracking-wide py-2.5 rounded-lg transition-all shadow-sm border border-amber-500 mb-2"
			>
				ПОЧАТИ ПРИГОТУВАННЯ
			</button>
			<button
				hx-get={ fmt.Sprintf("/chef/kitchen/tasks/%d/issue-modal", task.OrderItemID) }
				hx-target="#chef-modal"
				hx-swap="innerHTML"
				class="w-full bg-red-100 hover:bg-red-200 text-red-700 text-sm font-bold uppercase tracking-wide py-2.5 rounded-lg transition-all border border-red-300"
			>
				НЕМАЄ ПРОДУКТІВ
			</button>
		}
		if task.Status == chefservice.TaskStatusCooking && task.ChefID == currentChefID {
			<button
				hx-post={ fmt.Sprintf("/chef/kitchen/tasks/%d/finish", task.CookingTaskID) }
				hx-disable-elt="this"
				hx-indicator="this"
				class="w-full bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wide py-2.5 rounded-lg transition-all shadow-sm border border-green-600 disabled:opacity-60"
			>
				ГОТОВО
			</button>
		}
	</div>
}

// fmtQty форматує float64 без зайвих нулів (0.050 → "0.05", 1.0 → "1").
func fmtQty(v float64) string {
	if v <= 0 {
		return ""
	}
	s := strconv.FormatFloat(v, 'f', 3, 64)
	s = strings.TrimRight(s, "0")
	s = strings.TrimRight(s, ".")
	return s
}

// StartCookingModal — модальне вікно з рецептом страви перед стартом приготування.
// Завантажується в #chef-modal через HTMX GET.
templ StartCookingModal(data chefservice.StartCookingView) {
	<div
		class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40"
		onclick="if(event.target===this)this.closest('#chef-modal').innerHTML=''"
	>
		<div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col">
			<!-- Заголовок -->
			<div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-shrink-0">
				<div>
					<h3 class="font-semibold text-slate-800">Почати приготування</h3>
					<p class="text-sm text-slate-500 mt-0.5 mono">{ data.DishName } · { fmt.Sprintf("%d", data.Qty) } порц.</p>
				</div>
				<button
					onclick="document.getElementById('chef-modal').innerHTML=''"
					class="text-slate-400 hover:text-slate-600"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>
			<!-- Форма -->
			<form
				hx-post={ fmt.Sprintf("/chef/kitchen/tasks/%d/start", data.OrderItemID) }
				hx-on--after-request="if(event.detail.successful)document.getElementById('chef-modal').innerHTML=''"
				class="flex-1 overflow-hidden flex flex-col min-h-0"
				onsubmit="var errs=document.querySelectorAll('#kds-ing-list [id$=-err]');for(var i=0;i<errs.length;i++){if(errs[i].textContent.trim()){alert('Виправте помилки перед збереженням.');return false;}}"
			>
				<!-- Пошук -->
				<div class="px-6 py-3 border-b border-slate-100 flex gap-2 flex-shrink-0">
					<input
						type="text"
						placeholder="Пошук інгредієнта..."
						oninput="kdsIngFilter(this.value)"
						class="flex-1 border border-slate-200 rounded-lg px-3 py-2 text-sm"
					/>
					<button
						type="button"
						onclick="kdsIngFilter('');this.previousElementSibling.value=''"
						class="border border-slate-200 text-slate-600 px-3 py-2 rounded-lg text-sm hover:bg-slate-50"
					>
						Очистити
					</button>
				</div>
				<!-- Список інгредієнтів -->
				<div class="px-6 py-4 overflow-y-auto flex-1">
					<!-- Шапка таблиці -->
					<div class="grid grid-cols-[5px_1fr_110px_96px] gap-2 text-[11px] font-bold text-slate-500 uppercase tracking-wide pb-2 border-b border-slate-200 mb-1">
						<div></div>
						<div>Інгредієнт</div>
						<div class="text-right">Кількість</div>
						<div class="pl-2">Од. виміру</div>
					</div>
					<!-- Рядки інгредієнтів -->
					<div id="kds-ing-list">
						if len(data.Recipe) > 0 {
							<div class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wide pt-2 pb-1">Рецепт</div>
						}
						for _, ing := range data.Recipe {
							@kdsIngRow(ing, true)
						}
						if len(data.Others) > 0 {
							<div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide pt-3 pb-1">Інші інгредієнти</div>
						}
						for _, ing := range data.Others {
							@kdsIngRow(ing, false)
						}
					</div>
				</div>
				<!-- Футер -->
				<div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex gap-3 flex-shrink-0">
					<button
						type="submit"
						class="flex-1 bg-amber-500 hover:bg-amber-600 text-amber-900 font-bold uppercase tracking-wide py-2.5 rounded-lg border border-amber-600 transition-all"
					>
						Почати приготування
					</button>
					<button
						type="button"
						onclick="document.getElementById('chef-modal').innerHTML=''"
						class="flex-1 border border-slate-200 text-slate-600 font-medium py-2.5 rounded-lg hover:bg-white transition-colors"
					>
						Скасувати
					</button>
				</div>
			</form>
		</div>
	</div>
	<script>
	function kdsIngFilter(q) {
		q = (q || '').toLowerCase();
		document.querySelectorAll('#kds-ing-list [data-ing]').forEach(function(row) {
			row.style.display = (!q || (row.dataset.ing || '').toLowerCase().indexOf(q) >= 0) ? '' : 'none';
		});
	}
	function kdsIngToggle(chk, inputId) {
		var inp = document.getElementById(inputId);
		if (!inp) return;
		var row = chk.closest('[data-ing]');
		if (chk.checked) {
			inp.disabled = false;
			if (inp.dataset.savedVal !== undefined && inp.dataset.savedVal !== '') {
				inp.value = inp.dataset.savedVal;
			}
			kdsIngQtyCheck(inp);
			if (row) { row.classList.add('bg-emerald-50'); row.classList.remove('bg-white'); }
		} else {
			inp.dataset.savedVal = inp.value;
			inp.disabled = true;
			inp.value = '';
			var errEl = document.getElementById(inputId + '-err');
			if (errEl) errEl.textContent = '';
			if (row) { row.classList.remove('bg-emerald-50'); row.classList.add('bg-white'); }
		}
	}
	function kdsIngQtyCheck(inp) {
		var stock = parseFloat(inp.dataset.stock || '0');
		var unit = inp.dataset.unit || '';
		var val = parseFloat(inp.value || '0');
		var errEl = document.getElementById(inp.id + '-err');
		if (!errEl) return;
		if (stock > 0 && val > stock) {
			var displayQty, displayUnit;
			if (unit === 'г') {
				displayQty = parseFloat((stock / 1000).toFixed(3)); displayUnit = 'кг';
			} else if (unit === 'мл') {
				displayQty = parseFloat((stock / 1000).toFixed(3)); displayUnit = 'л';
			} else {
				displayQty = parseFloat(stock.toFixed(3)); displayUnit = unit;
			}
			errEl.textContent = 'Завелика кількість. На складі доступно лише ' + displayQty + ' ' + displayUnit + '.';
		} else {
			errEl.textContent = '';
		}
	}
	</script>
}

// kdsIngRow — один рядок інгредієнта у модальному вікні.
templ kdsIngRow(ing chefservice.IngredientView, checked bool) {
	{{ inputID := fmt.Sprintf("kds-ing-%d", ing.ID) }}
	{{ fieldName := fmt.Sprintf("ing_%d", ing.ID) }}
	<div
		data-ing={ strings.ToLower(ing.Name) }
		class={ "grid grid-cols-[20px_1fr_110px_76px] items-start gap-2 py-1.5 border-b border-slate-100 last:border-0 rounded px-1",
			templ.KV("bg-emerald-50", checked),
			templ.KV("bg-white", !checked) }
	>
		<input
			type="checkbox"
			id={ fmt.Sprintf("kds-chk-%d", ing.ID) }
			data-inp={ inputID }
			if checked {
				checked
			}
			onchange="kdsIngToggle(this,this.dataset.inp)"
			class="rounded text-blue-600 focus:ring-blue-500 mt-1"
		/>
		<div class="flex items-center gap-2 min-w-0">
			<label
				for={ fmt.Sprintf("kds-chk-%d", ing.ID) }
				class={ "text-sm cursor-pointer select-none truncate shrink min-w-0",
					templ.KV("font-semibold text-slate-800", checked),
					templ.KV("text-slate-600", !checked) }
			>
				{ ing.Name }
			</label>
			<span id={ inputID + "-err" } class="text-[10px] text-red-500 shrink-0 ml-auto whitespace-nowrap"></span>
		</div>
		<input
			id={ inputID }
			name={ fieldName }
			type="number"
			step="0.001"
			min="0"
			value={ fmtQty(ing.RecipeQty) }
			data-stock={ fmtQty(ing.StockQty) }
			data-unit={ ing.Unit }
			if !checked {
				disabled
			}
			oninput="kdsIngQtyCheck(this)"
			onkeydown="if(event.key==='-'||event.key==='e'||event.key==='E')event.preventDefault()"
			class="border border-slate-200 rounded-lg px-2 py-1 text-sm mono text-right w-full disabled:bg-slate-100 disabled:text-slate-400"
		/>
		<div class="text-xs text-slate-500 pt-1 pl-2">{ ing.Unit }</div>
	</div>
}

// IssueModal — модальне вікно підтвердження нестачі продуктів.
// Завантажується в #chef-modal через HTMX GET.
templ IssueModal(taskID int, dishName string, qty int) {
	<div
		class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40"
		onclick="if(event.target===this)this.closest('#chef-modal').innerHTML=''"
	>
		<div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
			<div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
				<div>
					<h3 class="font-semibold text-slate-800">Нестача інгредієнтів</h3>
					<p class="text-xs text-slate-500 mt-0.5 mono">{ dishName } · { fmt.Sprintf("%d", qty) } порц.</p>
				</div>
				<button
					onclick="document.getElementById('chef-modal').innerHTML=''"
					class="text-slate-400 hover:text-slate-600"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>
			<div class="px-6 py-4">
				<p class="text-sm text-slate-600">
					Позицію буде видалено з черги. Офіціант отримає сповіщення.
				</p>
			</div>
			<div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex gap-3">
				<button
					hx-post={ fmt.Sprintf("/chef/kitchen/tasks/%d/report-issue", taskID) }
					hx-target="#kitchen-board"
					hx-swap="outerHTML"
					hx-on--after-request="document.getElementById('chef-modal').innerHTML=''"
					class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold uppercase tracking-wide py-2.5 rounded-lg border border-red-700 transition-all"
				>
					Підтвердити
				</button>
				<button
					onclick="document.getElementById('chef-modal').innerHTML=''"
					class="flex-1 border border-slate-200 text-slate-600 font-medium py-2.5 rounded-lg hover:bg-white transition-colors"
				>
					Скасувати
				</button>
			</div>
		</div>
	</div>
}
