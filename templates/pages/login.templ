package pages

templ Login(errMsg string) {
	<!DOCTYPE html>
	<html lang="uk">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>RestaurantOS — Вхід</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<style>
			{ `* { font-family: 'IBM Plex Sans', sans-serif; }` }
			{ `.mono { font-family: 'IBM Plex Mono', monospace; }` }
			{ `.input-field { transition: border-color 0.15s; }` }
			{ `.input-field:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }` }
			{ `.btn-primary { transition: all 0.15s; }` }
			{ `.btn-primary:hover { filter: brightness(1.1); }` }
			{ `.btn-primary:active { transform: scale(0.98); }` }
			{ `@keyframes slideUp { from { opacity:0; transform:translateY(20px) scale(0.98); } to { opacity:1; transform:translateY(0) scale(1); } }` }
			{ `.slide-up { animation: slideUp 0.22s ease; }` }
			{ `@keyframes spin { to { transform: rotate(360deg); } }` }
		</style>
	</head>
	<body class="bg-slate-900 overflow-hidden h-screen">
		<div class="min-h-screen flex items-center justify-center">
			<div class="w-full max-w-sm slide-up">
				<div class="text-center mb-8">
					<div class="inline-flex items-center gap-2 mb-3">
						<div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center">
							<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						<span class="text-white font-semibold text-xl tracking-tight">RestaurantOS</span>
					</div>
					<p class="text-slate-400 text-sm">Інформаційна система мережі ресторанів</p>
				</div>
				<div class="bg-slate-800 rounded-2xl p-6 border border-slate-700">
					<h2 class="text-white font-semibold text-lg mb-5">Вхід до системи</h2>
					<form method="POST" action="/login" class="space-y-4">
						<div>
							<label class="text-slate-400 text-xs font-medium uppercase tracking-wider block mb-1.5">
								Номер телефону
							</label>
							<input
								id="phone"
								name="phone"
								type="text"
								placeholder="+380XXXXXXXXX"
								inputmode="tel"
								oninput="this.value=this.value.replace(/[^+0-9]/g,'').replace(/(?!^)\+/g,'');"
								class="input-field mono w-full bg-slate-700 border border-slate-600 rounded-lg px-3.5 py-2.5 text-white placeholder-slate-500 text-sm"
								required
								autofocus
							/>
						</div>
						<div>
							<label class="text-slate-400 text-xs font-medium uppercase tracking-wider block mb-1.5">
								PIN-код
							</label>
							<input
								id="pin"
								name="pin"
								type="password"
								placeholder="••••"
								maxlength="4"
								inputmode="numeric"
								oninput="this.value=this.value.replace(/[^0-9]/g,'');"
								class="input-field mono w-full bg-slate-700 border border-slate-600 rounded-lg px-3.5 py-2.5 text-white placeholder-slate-500 text-sm"
								required
							/>
						</div>
						if errMsg != "" {
							<div class="text-red-400 text-xs bg-red-900/30 border border-red-800 rounded-lg px-3 py-2">
								{ errMsg }
							</div>
						}
						<button
							type="submit"
							class="btn-primary w-full bg-blue-600 hover:bg-blue-500 text-white font-medium py-2.5 rounded-lg text-sm mt-1"
						>
							Увійти
						</button>
					</form>
				</div>
			</div>
		</div>
	<div id="toast-429" style="position:fixed;top:1.25rem;left:50%;transform:translateX(-50%) translateY(-120%);transition:transform .3s ease,opacity .3s ease;opacity:0;z-index:9999;background:#ea580c;color:#fff;padding:.6rem 1.25rem;border-radius:.5rem;font-size:.85rem;white-space:nowrap;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.35);">
		⚠ Забагато запитів — спробуйте пізніше
	</div>
	<script>
		(function() {
			var _toastTimer;
			function showToast429() {
				var t = document.getElementById('toast-429');
				if (!t) return;
				clearTimeout(_toastTimer);
				t.style.opacity = '1';
				t.style.transform = 'translateX(-50%) translateY(0)';
				_toastTimer = setTimeout(function() {
					t.style.opacity = '0';
					t.style.transform = 'translateX(-50%) translateY(-120%)';
				}, 3000);
			}
			var SPINNER = '<svg class="inline-block w-4 h-4 mr-2 animate-spin" style="animation:spin .7s linear infinite" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="40 20" stroke-linecap="round"/></svg>Зачекайте...';
			var form = document.querySelector('form');
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				var btn = form.querySelector('button[type=submit]');
				btn.disabled = true;
				btn.innerHTML = SPINNER;
				fetch('/login', { method: 'POST', body: new FormData(form) })
					.then(function(res) {
						if (res.status === 429) {
							btn.disabled = false;
							btn.innerHTML = 'Увійти';
							showToast429();
							return;
						}
						if (res.redirected) {
							window.location.href = res.url;
							return;
						}
						return res.text().then(function(html) {
							var doc = new DOMParser().parseFromString(html, 'text/html');
							document.body.innerHTML = doc.body.innerHTML;
						});
					})
					.catch(function() { btn.disabled = false; btn.innerHTML = 'Увійти'; });
			});
		})();
	</script>
	</body>
	</html>
}
