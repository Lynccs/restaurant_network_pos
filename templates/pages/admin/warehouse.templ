package adminpages

import (
	"fmt"
	"math"
	"net/url"
	"strconv"
	"strings"
	"time"

	adminservice "restaurant_network_pos/internal/service/admin"
)

func warehouseExpClass(days int) string {
	switch {
	case days < 0:
		return "text-red-700 font-bold"
	case days < 3:
		return "text-red-600 font-medium"
	case days < 7:
		return "text-amber-600 font-medium"
	default:
		return "text-slate-600 font-medium"
	}
}

func warehouseExpMeta(days int) string {
	switch {
	case days < 0:
		return "ПРОСТРОЧЕНО (" + strconv.Itoa(-days) + " дн)"
	case days < 7:
		return "(" + strconv.Itoa(days) + " дн.)"
	default:
		return "(" + strconv.Itoa(days) + " дн.)"
	}
}

func warehouseSelectedIngredientsMap(values []string) map[string]bool {
	result := make(map[string]bool, len(values))
	for _, value := range values {
		result[value] = true
	}
	return result
}

func warehouseHasActiveFilters(f adminservice.WarehouseFilters, defaultRestaurantID int) bool {
	return len(f.Ingredients) > 0 || f.MinQty != "" || f.MaxQty != "" ||
		f.ArrivalFrom != "" || f.ArrivalTo != "" || f.ExpFrom != "" || f.ExpTo != "" ||
		(f.Status != "" && f.Status != "not_expired") ||
		(defaultRestaurantID > 0 && f.RestaurantID != 0 && f.RestaurantID != defaultRestaurantID)
}

func warehousePageLink(f adminservice.WarehouseFilters, page int) string {
	values := url.Values{}
	if f.RestaurantID > 0 {
		values.Set("restaurant_id", strconv.Itoa(f.RestaurantID))
	}
	for _, ingredient := range f.Ingredients {
		values.Add("ingredient", ingredient)
	}
	if f.Status != "" && f.Status != "not_expired" {
		values.Set("status", f.Status)
	}
	if f.ArrivalFrom != "" {
		values.Set("arrival_from", f.ArrivalFrom)
	}
	if f.ArrivalTo != "" {
		values.Set("arrival_to", f.ArrivalTo)
	}
	if f.ExpFrom != "" {
		values.Set("exp_from", f.ExpFrom)
	}
	if f.ExpTo != "" {
		values.Set("exp_to", f.ExpTo)
	}
	if f.MinQty != "" {
		values.Set("min_qty", f.MinQty)
	}
	if f.MaxQty != "" {
		values.Set("max_qty", f.MaxQty)
	}
	values.Set("page", strconv.Itoa(page))
	return "/admin/warehouse?" + values.Encode()
}

func warehouseFmtDate(t time.Time) string {
	return t.Format("2006-01-02")
}

func warehouseQtyDisplay(qty float64, unit string) (string, string) {
	displayQty := qty
	displayUnit := unit
	if (unit == "г" || unit == "мл") && math.Abs(math.Mod(qty, 1000)) < 0.0001 {
		displayQty = qty / 1000
		switch unit {
		case "г":
			displayUnit = "кг"
		case "мл":
			displayUnit = "л"
		}
	}
	return fmtQty(displayQty), displayUnit
}

templ WarehousePage(view *adminservice.WarehousePageView) {
	{{ selectedIngredients := warehouseSelectedIngredientsMap(view.Filters.Ingredients) }}
	<div class="p-6 max-w-6xl mx-auto fade-in" data-current-restaurant-id={ strconv.Itoa(view.DefaultRestaurantID) }>
		<style>
			.input-field { transition: border-color 0.15s; }
			.input-field:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
			#warehouse-filter-modal { display: none; }
			#warehouse-filter-modal.open { display: flex; }
		</style>

		<div class="mb-6">
			<h1 class="text-xl font-semibold text-slate-900">Склад</h1>
			<div class="mt-1">
				<p class="text-slate-700 text-sm font-medium">Ваш ресторан: { view.CurrentRestaurantName }</p>
				if view.CurrentRestaurantAddress != "" {
					<p class="text-slate-500 text-xs">{ view.CurrentRestaurantAddress }</p>
				}
			</div>
		</div>

		<div class="mb-4 flex items-center justify-between">
			<div class="flex items-center gap-3">
				<button type="button" onclick="warehouseOpenFilters()" class="btn-primary bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-sm text-sm px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
					Фільтри
				</button>
				if warehouseHasActiveFilters(view.Filters, view.DefaultRestaurantID) {
					<a href="/admin/warehouse" class="bg-red-50 hover:bg-red-100 border border-red-200 text-red-600 text-sm px-4 py-2 rounded-lg font-medium shadow-sm transition-colors flex items-center gap-1.5">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
						Скинути всі фільтри
					</a>
				} else {
					<button disabled class="bg-slate-50 border border-slate-200 text-slate-400 text-sm px-4 py-2 rounded-lg font-medium flex items-center gap-1.5 cursor-not-allowed">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
						Скинути всі фільтри
					</button>
				}
			</div>
		</div>

		<div id="warehouse-writeoff" class="hidden bg-white border border-slate-200 rounded-2xl p-5 mb-6 shadow-sm">
			<form
				id="warehouse-writeoff-form"
				hx-post="/admin/warehouse/writeoff"
				hx-swap="outerHTML"
				hx-on--after-request="if(event.detail.successful) { warehouseCancelWriteOff(); } else { alert('Помилка при списанні'); }"
				onsubmit="warehousePrepareWriteOff(event)"
				class="flex flex-wrap md:flex-nowrap items-end gap-4"
			>
				<input type="hidden" name="stock_id" id="wo-stock-id" value=""/>
				<input type="hidden" name="quantity" id="wo-final-quantity" value=""/>
				
				<div class="flex-[2] min-w-[200px]">
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5 ml-1">Інгредієнт</label>
					<input type="text" id="wo-ingredient" readonly class="input-field w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-slate-50 text-slate-700 font-medium"/>
				</div>

				<div class="w-28">
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5 ml-1">Кількість</label>
					<input type="number" id="wo-display-quantity" step="0.001" min="0" onkeydown="if(['-','+','e','E'].includes(event.key))event.preventDefault()" required class="input-field w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-mono"/>
				</div>

				<div class="w-24 relative">
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5 ml-1">Одиниця</label>
					<select id="wo-unit-select" class="input-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white cursor-pointer appearance-none pr-8">
					</select>
					<div class="absolute right-3 bottom-3 pointer-events-none text-slate-400">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
					</div>
				</div>

				<div class="flex-[2] min-w-[180px] relative">
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5 ml-1">Причина списання</label>
					<select name="reason_id" required class="input-field w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white cursor-pointer appearance-none pr-8">
						<option value="">Оберіть причину</option>
						for _, reason := range view.WriteOffReasons {
							<option value={ strconv.Itoa(reason.ID) }>{ reason.Name }</option>
						}
					</select>
					<div class="absolute right-3 bottom-3 pointer-events-none text-slate-400">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
					</div>
				</div>

				<div class="flex gap-2 min-w-[220px]">
					<button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white text-sm py-2.5 rounded-xl font-bold shadow-sm transition-all hover:shadow-md active:scale-[0.98]">Списати</button>
					<button type="button" onclick="warehouseCancelWriteOff()" class="flex-1 border bg-white border-slate-200 text-slate-600 text-sm py-2.5 rounded-xl font-bold hover:bg-slate-50 transition-all active:scale-[0.98]">Скасувати</button>
				</div>
			</form>
		</div>

		<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
			<div class="overflow-x-auto md:overflow-x-visible">
				<table class="w-full table-fixed">
					<thead class="bg-slate-50 border-b border-slate-200">
						<tr>
							<th class="w-[4%] px-3 py-3"></th>
							<th class="w-[16%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Інгредієнт</th>
							<th class="w-[12%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Кількість</th>
							<th class="w-[15%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Зона зберігання</th>
							<th class="w-[17%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Ресторан</th>
							<th class="w-[16%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Постачальник</th>
							<th class="w-[10%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Дата надходження</th>
							<th class="w-[14%] text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 py-3">Придатний до</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100" id="warehouse-table-body">
						for _, item := range view.Items {
							@WarehouseStockGroup(item, false, nil)
						}
						if len(view.Items) == 0 {
							<tr>
								<td colspan="8" class="px-5 py-8 text-center text-sm text-slate-400">Немає записів за поточними фільтрами</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if view.Pagination.TotalPages > 1 {
				<div class="px-5 py-4 border-t border-slate-100 flex items-center justify-between text-sm text-slate-500">
					<span>{ fmt.Sprintf("Сторінка %d з %d · усього записів: %d", view.Pagination.Page, view.Pagination.TotalPages, view.Pagination.TotalOrders) }</span>
					<div class="flex items-center gap-1">
						for _, pn := range purchasePageNums(view.Pagination.Page, view.Pagination.TotalPages) {
							if pn == 0 {
								<span class="px-1 text-slate-300">…</span>
							} else if pn == view.Pagination.Page {
								<span class="px-3 py-1.5 bg-blue-500 text-white rounded-lg font-medium">{ strconv.Itoa(pn) }</span>
							} else {
								<a href={ warehousePageLink(view.Filters, pn) } class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">{ strconv.Itoa(pn) }</a>
							}
						}
					</div>
				</div>
			}
		</div>

		<div id="warehouse-filter-modal" class="fixed inset-0 bg-black/40 z-50 items-center justify-center p-4 backdrop-blur-sm" onclick="warehouseFilterOverlayClick(event)">
			<form method="GET" action="/admin/warehouse" class="bg-white rounded-2xl shadow-2xl w-full max-w-lg slide-up max-h-[90vh] flex flex-col overflow-hidden">
				<div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
					<h3 class="font-bold text-slate-800 text-lg">Фільтрація запасів</h3>
					<button type="button" onclick="warehouseCloseFilters()" class="text-slate-400 hover:text-slate-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
				</div>
				<div class="px-6 py-5 overflow-y-auto scrollbar-thin flex-1 space-y-5">
					<div>
						<label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Заклад</label>
						<select name="restaurant_id" class="input-field w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:border-blue-500 outline-none">
							for _, restaurant := range view.RestaurantOptions {
								<option value={ strconv.Itoa(restaurant.ID) } selected?={ restaurant.ID == view.Filters.RestaurantID }>
									{ restaurant.Name }
									if restaurant.Address != "" {
										{ " — " + restaurant.Address }
									}
								</option>
							}
						</select>
					</div>

					<div>
						<label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Статус</label>
						<select name="status" class="input-field w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:border-blue-500 outline-none">
							<option value="all" selected?={ view.Filters.Status == "all" }>Усі (включаючи прострочені)</option>
							<option value="not_expired" selected?={ view.Filters.Status == "not_expired" || view.Filters.Status == "" }>Свіжі (не прострочені)</option>
							<option value="normal" selected?={ view.Filters.Status == "normal" }>Норма (>3 дн.)</option>
							<option value="expiring" selected?={ view.Filters.Status == "expiring" }>Скоро спливає (≤3 дн.)</option>
							<option value="expired" selected?={ view.Filters.Status == "expired" }>Прострочено</option>
						</select>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Кількість (від-до)</label>
							<div class="flex items-center gap-2">
								<input type="number" name="min_qty" value={ view.Filters.MinQty } class="input-field w-full border border-slate-200 rounded-lg px-2 py-2 text-sm text-center mono outline-none" min="0"/>
								<span class="text-slate-400">-</span>
								<input type="number" name="max_qty" value={ view.Filters.MaxQty } class="input-field w-full border border-slate-200 rounded-lg px-2 py-2 text-sm text-center mono outline-none" min="0"/>
							</div>
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Дата надходження</label>
							<input type="date" name="arrival_from" value={ view.Filters.ArrivalFrom } class="input-field w-full border border-slate-200 rounded-lg px-2 py-2 text-sm outline-none mb-2"/>
							<input type="date" name="arrival_to" value={ view.Filters.ArrivalTo } class="input-field w-full border border-slate-200 rounded-lg px-2 py-2 text-sm outline-none"/>
						</div>
						<div>
							<label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Термін придатності</label>
							<input type="date" name="exp_from" value={ view.Filters.ExpFrom } class="input-field w-full border border-slate-200 rounded-lg px-2 py-2 text-sm outline-none mb-2"/>
							<input type="date" name="exp_to" value={ view.Filters.ExpTo } class="input-field w-full border border-slate-200 rounded-lg px-2 py-2 text-sm outline-none"/>
						</div>
					</div>

					<div>
						<label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Продукти (мультивибір)</label>
						<input type="text" id="warehouse-ing-search" placeholder="Пошук інгредієнта..." oninput="warehouseFilterIngredientList(this.value)" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:border-blue-500 outline-none mb-2"/>
						<div class="mt-2 max-h-48 overflow-y-auto scrollbar-thin pr-1 border border-slate-200 rounded-lg p-2 bg-slate-50" id="warehouse-ingredient-list">
							for _, ingredient := range view.IngredientOptions {
								<label class="warehouse-ing-lbl flex items-center justify-between bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm font-medium cursor-pointer hover:bg-slate-50 transition-colors mb-1" data-name={ strings.ToLower(ingredient) }>
									<span>{ ingredient }</span>
									<input type="checkbox" name="ingredient" value={ ingredient } class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer" checked?={ selectedIngredients[ingredient] }/>
								</label>
							}
						</div>
					</div>
				</div>
				<input type="hidden" name="page" value="1"/>
				<div class="px-6 py-4 border-t border-slate-100 flex gap-3 bg-slate-50 rounded-b-2xl">
					<button type="submit" class="btn-primary flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm py-2.5 rounded-lg font-bold shadow-sm transition-colors">Застосувати</button>
					<a href="/admin/warehouse" class="flex-1 bg-red-50 hover:bg-red-100 border border-red-200 text-red-600 text-sm py-2.5 rounded-lg font-bold shadow-sm transition-colors text-center">Скинути всі</a>
					<button type="button" onclick="warehouseCloseFilters()" class="flex-1 border bg-white border-slate-200 text-slate-700 text-sm py-2.5 rounded-lg font-bold hover:bg-slate-50 transition-colors">Скасувати</button>
				</div>
			</form>
		</div>

		<script>
			function warehouseOpenFilters() {
				var modal = document.getElementById('warehouse-filter-modal');
				if (modal) modal.classList.add('open');
			}
			function warehouseCloseFilters() {
				var modal = document.getElementById('warehouse-filter-modal');
				if (modal) modal.classList.remove('open');
			}
			function warehouseFilterOverlayClick(event) {
				var modal = document.getElementById('warehouse-filter-modal');
				if (event.target === modal) warehouseCloseFilters();
			}
			function warehouseFilterIngredientList(val) {
				var query = (val || '').toLowerCase();
				document.querySelectorAll('.warehouse-ing-lbl').forEach(function(el) {
					el.style.display = el.dataset.name.indexOf(query) >= 0 ? 'flex' : 'none';
				});
			}
			function warehouseSelectStock(row, skipExpand) {
				var container = document.querySelector('[data-current-restaurant-id]');
				var currentRestaurantID = container ? container.dataset.currentRestaurantId : '0';
				var rowRestaurantID = row.dataset.restaurantId || '0';
				
				// Handle highlighting
				document.querySelectorAll('.warehouse-row').forEach(function(r) {
					r.classList.remove('bg-blue-50/50', 'border-l-4', 'border-blue-500');
				});
				row.classList.add('bg-blue-50/50', 'border-l-4', 'border-blue-500');

				// Show write-off form only if it's the current restaurant
				if (rowRestaurantID === currentRestaurantID) {
					var block = document.getElementById('warehouse-writeoff');
					var stockInput = document.getElementById('wo-stock-id');
					var ingInput = document.getElementById('wo-ingredient');
					var qtyDisplay = document.getElementById('wo-display-quantity');
					var unitSelect = document.getElementById('wo-unit-select');
					
					if (block && stockInput && ingInput && qtyDisplay && unitSelect) {
						stockInput.value = row.dataset.stockId || '';
						ingInput.value = row.dataset.ingredient || '';
						
						// Update unit select options
						var baseUnit = row.dataset.unit || '';
						unitSelect.innerHTML = '';
						if (baseUnit === 'г') {
							unitSelect.innerHTML = '<option value="г">г</option><option value="кг">кг</option>';
						} else if (baseUnit === 'мл') {
							unitSelect.innerHTML = '<option value="мл">мл</option><option value="л">л</option>';
						} else {
							unitSelect.innerHTML = '<option value="' + baseUnit + '">' + baseUnit + '</option>';
						}

						qtyDisplay.value = '';
						block.classList.remove('hidden');
					}
				} else {
					var block = document.getElementById('warehouse-writeoff');
					if (block) block.classList.add('hidden');
				}

				if (skipExpand) return;

				// Toggle expansion for any row
				var stockId = row.dataset.stockId;
				var expandRow = document.getElementById('expand-row-' + stockId);
				var icon = row.querySelector('.expand-icon');
				
				if (expandRow) {
					var isHidden = expandRow.classList.contains('hidden');
					
					// Close other expanded rows
					document.querySelectorAll('.expand-row').forEach(function(r) { 
						if (r.id !== 'expand-row-' + stockId) r.classList.add('hidden'); 
					});
					document.querySelectorAll('.expand-icon').forEach(function(i) {
						if (i !== icon) i.style.transform = 'rotate(0deg)';
					});

					if (isHidden) {
						expandRow.classList.remove('hidden');
						if (icon) icon.style.transform = 'rotate(90deg)';
						
						// Trigger HTMX if content has spinner
						var content = document.getElementById('stock-expand-' + stockId);
						if (content && content.querySelector('.animate-spin')) {
							htmx.trigger(content, 'expand-triggered');
						}
					} else {
						expandRow.classList.add('hidden');
						if (icon) icon.style.transform = 'rotate(0deg)';
					}
				}
			}
			function warehousePrepareWriteOff(event) {
				var qtyDisplay = document.getElementById('wo-display-quantity');
				var unitSelect = document.getElementById('wo-unit-select');
				var finalQty = document.getElementById('wo-final-quantity');
				
				if (qtyDisplay && unitSelect && finalQty) {
					var val = parseFloat(qtyDisplay.value.replace(',', '.'));
					if (isNaN(val)) {
						event.preventDefault();
						return;
					}
					
					if (unitSelect.value === 'кг' || unitSelect.value === 'л') {
						val *= 1000;
					}
					finalQty.value = val;
				}
			}
			function warehouseCancelWriteOff() {
				var block = document.getElementById('warehouse-writeoff');
				var stockInput = document.getElementById('wo-stock-id');
				var ingInput = document.getElementById('wo-ingredient');
				var qtyDisplay = document.getElementById('wo-display-quantity');
				if (!block || !stockInput || !ingInput || !qtyDisplay) return;
				stockInput.value = '';
				ingInput.value = '';
				qtyDisplay.value = '';
				block.classList.add('hidden');

				// Remove highlights
				document.querySelectorAll('.warehouse-row').forEach(function(r) {
					r.classList.remove('bg-blue-50/50', 'border-l-4', 'border-blue-500');
				});
			}
		</script>
	</div>
}

templ WarehouseWriteOffs(items []adminservice.WarehouseWriteOff, unit string) {
	<div class="bg-slate-50 p-4 rounded-xl border border-slate-200 my-2 ml-10 mr-4 fade-in">
		<div class="flex items-center gap-2 mb-4">
			<svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
			<h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest">Історія списань</h4>
		</div>
		
		<div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
			<table class="w-full text-sm text-left">
				<thead class="bg-slate-50 border-b border-slate-200">
					<tr>
						<th class="px-4 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Кількість</th>
						<th class="px-4 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Причина</th>
						<th class="px-4 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Адміністратор</th>
						<th class="px-4 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Точний час</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					for _, item := range items {
						<tr class="hover:bg-slate-50/50 transition-colors">
							<td class="px-4 py-2.5 font-bold text-red-600">-{ fmtQty(item.Qty) } { unit }</td>
							<td class="px-4 py-2.5 text-slate-600">{ item.Reason }</td>
							<td class="px-4 py-2.5 text-slate-600 font-medium">{ item.AdminName }</td>
							<td class="px-4 py-2.5 text-slate-400 font-mono text-xs">{ item.WriteOffDate.Format("02.01.2006 15:04:05") }</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan="4" class="px-4 py-6 text-center text-slate-400 italic">Списань не знайдено</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ WarehouseStockGroup(item adminservice.WarehouseBatch, showHistory bool, history []adminservice.WarehouseWriteOff) {
	<tbody id={ "stock-group-" + strconv.Itoa(item.StockID) } class="divide-y divide-slate-100 group/body">
		@WarehouseStockRow(item, showHistory)
		@WarehouseExpandRow(item, showHistory, history)
	</tbody>
}

templ WarehouseStockRow(item adminservice.WarehouseBatch, showHistory bool) {
	<tr class={ "warehouse-row hover:bg-slate-50 group transition-all duration-150", templ.KV("cursor-pointer", item.WriteOffCount > 0) }
		data-stock-id={ strconv.Itoa(item.StockID) }
		data-ingredient={ item.Ingredient }
		data-unit={ item.Unit }
		data-qty={ fmtQty(item.Qty) }
		data-restaurant-id={ strconv.Itoa(item.RestaurantID) }
		if item.WriteOffCount > 0 {
			onclick="warehouseSelectStock(this)"
		} else {
			onclick="warehouseSelectStock(this, true)"
		}
	>
		<td class="px-3 py-3 text-center">
			if item.WriteOffCount > 0 {
				if showHistory {
					<svg class="expand-icon w-4 h-4 text-slate-400 group-hover:text-blue-500 transition-all duration-200" style="transform: rotate(90deg);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
				} else {
					<svg class="expand-icon w-4 h-4 text-slate-400 group-hover:text-blue-500 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
				}
			}
		</td>
		<td class="px-3 py-3 text-sm font-medium text-slate-800 align-top break-words whitespace-normal">
			{ item.Ingredient }
		</td>
		{{ qtyValue, qtyUnit := warehouseQtyDisplay(item.Qty, item.Unit) }}
		<td class="px-3 py-3 text-sm mono font-semibold text-slate-700 align-top whitespace-nowrap">{ qtyValue } { qtyUnit }</td>
		<td class="px-3 py-3 text-sm align-top break-words"><span class="bg-slate-100 px-2 py-0.5 rounded-full text-xs text-slate-600">{ item.StorageZone }</span></td>
		<td class="px-3 py-3 text-sm text-slate-600 align-top break-words">
			<div class="flex flex-col">
				<span class="font-medium text-slate-700">{ item.RestaurantName }</span>
				if item.RestaurantAddress != "" {
					<span class="text-xs text-slate-500">{ item.RestaurantAddress }</span>
				}
			</div>
		</td>
		<td class="px-3 py-3 text-sm text-slate-500 align-top break-words">{ item.Supplier }</td>
		<td class="px-3 py-3 text-sm mono text-slate-500 align-top whitespace-nowrap">{ warehouseFmtDate(item.ReceivedAt) }</td>
		<td class={ "px-3 py-3 text-sm mono align-top", warehouseExpClass(item.DaysLeft) }>
			<div class="flex flex-col items-start">
				<span>{ warehouseFmtDate(item.ExpDate) }</span>
				if item.DaysLeft < 0 {
					<span class="bg-red-100 text-red-700 px-1.5 py-0.5 rounded text-[10px] uppercase font-bold tracking-wide mt-1">{ warehouseExpMeta(item.DaysLeft) }</span>
				} else {
					<span class="text-xs opacity-70 mt-1 block">{ warehouseExpMeta(item.DaysLeft) }</span>
				}
			</div>
		</td>
	</tr>
}

templ WarehouseExpandRow(item adminservice.WarehouseBatch, showHistory bool, history []adminservice.WarehouseWriteOff) {
	<tr id={ "expand-row-" + strconv.Itoa(item.StockID) } class={ "expand-row bg-slate-50/30", templ.KV("hidden", !showHistory) }>
		<td colspan="8" class="p-0 border-b border-slate-100">
			<div id={ "stock-expand-" + strconv.Itoa(item.StockID) }
				hx-get={ "/admin/warehouse/stock/" + strconv.Itoa(item.StockID) + "/writeoffs?unit=" + url.QueryEscape(item.Unit) }
				hx-trigger="expand-triggered"
				hx-swap="innerHTML">
				if showHistory {
					@WarehouseWriteOffs(history, item.Unit)
				} else {
					<div class="p-8 flex justify-center">
						<div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
					</div>
				}
			</div>
		</td>
	</tr>
}
