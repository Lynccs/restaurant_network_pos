package adminpages

import (
	"fmt"
	adminservice "restaurant_network_pos/internal/service/admin"
	"strconv"
)

templ SuppliersPage(suppliers []adminservice.SupplierView) {
	<div class="p-6 max-w-6xl mx-auto fade-in">
		<div class="flex items-center justify-between mb-8">
			<div>
				<h1 class="text-2xl font-bold text-slate-800 tracking-tight">Постачальники</h1>
				<p class="text-slate-500 text-sm mt-1">Реєстр контрагентів мережі</p>
			</div>
			<button
				hx-get="/admin/suppliers/new"
				hx-target="#admin-modal-content"
				hx-trigger="click"
				class="btn-primary bg-blue-600 text-white text-sm px-5 py-2.5 rounded-xl font-bold flex items-center gap-2 shadow-sm transition-all hover:bg-blue-700 active:scale-95"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
				</svg>
				Додати постачальника
			</button>
		</div>
		<div id="suppliers-list-container" hx-get="/admin/suppliers/list" hx-trigger="refreshSuppliers from:body">
			@SuppliersList(suppliers)
		</div>
	</div>
}

templ SuppliersList(suppliers []adminservice.SupplierView) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		if len(suppliers) == 0 {
			<div class="col-span-full py-20 text-center bg-white rounded-3xl border-2 border-dashed border-slate-200">
				<div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
					</svg>
				</div>
				<p class="text-slate-500 font-medium">Список постачальників порожній</p>
				<p class="text-slate-400 text-xs mt-1">Додайте свого першого контрагента</p>
			</div>
		} else {
			for _, s := range suppliers {
				<div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col gap-4 relative group hover:shadow-lg hover:border-blue-200 transition-all duration-300">
					<div class="absolute top-4 right-4 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
						<button
							hx-get={ fmt.Sprintf("/admin/suppliers/%d/edit", s.ID) }
							hx-target="#admin-modal-content"
							class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-colors"
							title="Редагувати"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
							</svg>
						</button>
					</div>
					<div>
						<h3 class="font-bold text-slate-800 text-lg leading-tight mb-1 pr-16">{ s.CompanyName }</h3>
						<div class="flex items-center gap-2 text-slate-500 text-xs">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
							</svg>
							{ s.ContactPerson }
						</div>
					</div>
					<div class="space-y-2 bg-slate-50/50 p-4 rounded-xl border border-slate-100">
						<div class="flex items-start gap-3">
							<svg class="w-4 h-4 text-slate-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
							<span class="text-xs text-slate-600 leading-normal">{ s.Address }</span>
						</div>
						<div class="flex items-center gap-3">
							<svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
							</svg>
							<span class="text-xs text-slate-700 font-medium mono">{ s.Phone }</span>
						</div>
						<div class="flex items-center gap-3 pt-2 mt-2 border-t border-slate-200/50 border-dashed">
							<svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
							</svg>
							<span class="text-[11px] text-slate-500 font-medium mono truncate" title={ s.PaymentDetails }>
								if s.PaymentDetails != "" {
									{ s.PaymentDetails }
								} else {
									Не вказано
								}
							</span>
						</div>
					</div>
					<div class="mt-2 pt-3 border-t border-slate-100 flex-1">
						<p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Асортимент інгредієнтів</p>
						<div class="flex flex-wrap gap-1.5 min-h-[1.5rem]">
							if len(s.Ingredients) > 0 {
								for _, ing := range s.Ingredients {
									<span class="bg-blue-50 text-blue-600 border border-blue-100 text-[10px] px-2 py-0.5 rounded-lg font-bold transition-all hover:bg-blue-100">{ ing }</span>
								}
							} else {
								<span class="text-[10px] text-slate-300 italic">Асортимент не вказано</span>
							}
						</div>
					</div>
					<div class="pt-2">
						<button
							hx-get={ fmt.Sprintf("/admin/suppliers/%d/edit", s.ID) }
							hx-target="#admin-modal-content"
							class="w-full py-2.5 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider hover:bg-slate-50 hover:border-slate-300 transition-colors flex items-center justify-center gap-2"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
							Редагувати картку
						</button>
					</div>
				</div>
			}
		}
	</div>
}

templ SupplierModal(view *adminservice.SupplierFormView) {
	{{ s := view.Supplier }}
	<div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg slide-up overflow-hidden max-h-[85vh]">
		<div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
			<div>
				<h3 class="font-bold text-slate-800 text-lg">
					if s.ID > 0 {
						Редагувати постачальника
					} else {
						Новий постачальник
					}
				</h3>
				<p class="text-[10px] text-slate-400 mt-1 uppercase tracking-widest font-semibold">Картка контрагента</p>
			</div>
			<button type="button" onclick="adminCloseModal()" class="w-10 h-10 flex items-center justify-center rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<form hx-post="/admin/suppliers" hx-swap="none" class="px-6 py-4 space-y-4 overflow-y-auto" style="max-height: calc(85vh - 4.5rem);">
			<input type="hidden" name="id" value={ strconv.Itoa(s.ID) }/>
			<div class="grid grid-cols-1 gap-4">
				<div>
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5">Назва компанії <span class="text-red-500">*</span></label>
					<input
						type="text"
						name="company_name"
						value={ s.CompanyName }
						placeholder="ТОВ 'Смак'"
						class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-medium"
						required
					/>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5">Контактна особа</label>
						<input
							type="text"
							name="contact_person"
							value={ s.ContactPerson }
							placeholder="Іванов І.І."
							class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm focus:bg-white focus:border-blue-500 transition-all outline-none font-medium"
						/>
					</div>
					<div>
						<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5">Телефон <span class="text-red-500">*</span></label>
						<input
							type="text"
							name="phone"
							value={ s.Phone }
							placeholder="+380..."
							class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm focus:bg-white focus:border-blue-500 transition-all outline-none font-medium mono"
							required
						/>
					</div>
				</div>
				<div>
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5">Адреса</label>
					<input
						type="text"
						name="address"
						value={ s.Address }
						placeholder="м. Київ, вул. Прикладна, 10"
						class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm focus:bg-white focus:border-blue-500 transition-all outline-none font-medium"
					/>
				</div>
				<div>
					<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1.5">Реквізити (IBAN)</label>
					<input
						type="text"
						name="payment_details"
						value={ s.PaymentDetails }
						placeholder="UA000000..."
						class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm focus:bg-white focus:border-blue-500 transition-all outline-none font-medium mono uppercase"
					/>
				</div>
			</div>
			<div class="pt-1">
				<label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest flex justify-between items-center mb-1.5">
					<span>Асортимент інгредієнтів</span>
				</label>
				<div class="relative mb-2">
					<svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<input
						type="text"
						placeholder="Пошук інгредієнтів..."
						class="w-full bg-white border border-slate-200 rounded-2xl pl-10 pr-3 py-2 text-xs focus:border-blue-500 focus:ring-4 focus:ring-blue-500/5 outline-none transition-all font-medium"
						onkeyup="filterSupplierIngredients(this.value)"
					/>
				</div>
				<div class="grid grid-cols-2 gap-2 max-h-[140px] overflow-y-auto scrollbar-thin pr-1" id="supplier-ingredients-grid">
					for _, ing := range view.Ingredients {
						<label class="ingredient-card flex items-center gap-2 bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs font-medium cursor-pointer hover:bg-slate-50 transition-colors">
							<input
								type="checkbox"
								name="ingredient_ids[]"
								value={ strconv.Itoa(ing.ID) }
								checked?={ view.SelectedIDs[ing.ID] }
								class="sup-ing-chk flex-shrink-0 rounded text-blue-600 focus:ring-blue-500 w-3.5 h-3.5 cursor-pointer"
							/>
							<span class="text-slate-700 truncate ing-name">{ ing.Name }</span>
							<span class="ml-auto text-[9px] font-bold text-slate-400 uppercase tracking-widest">{ ing.UnitName }</span>
						</label>
					}
				</div>
			</div>
			<div class="pt-3 flex gap-3">
				<button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition-all active:scale-95">
					if s.ID > 0 {
						Зберегти зміни
					} else {
						Створити картку
					}
				</button>
				<button type="button" onclick="adminCloseModal()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 font-semibold text-sm py-2.5 rounded-xl transition-all active:scale-95">
					Скасувати
				</button>
			</div>
		</form>
	</div>

	<script>
		function filterSupplierIngredients(query) {
			var q = (query || '').toLowerCase();
			document.querySelectorAll('#supplier-ingredients-grid .ingredient-card').forEach(function(card) {
				var name = card.querySelector('.ing-name').textContent.toLowerCase();
				card.style.display = name.includes(q) ? 'flex' : 'none';
			});
		}
	</script>
}

templ SupplierIngredientsModal(view *adminservice.SupplierIngredientsView) {
	<div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl slide-up overflow-hidden flex flex-col" style="max-height: 85vh;">
		<div class="px-8 py-6 border-b border-slate-100 shrink-0">
			<div class="flex items-center justify-between mb-1">
				<h3 class="font-bold text-slate-800 text-xl">Інгредієнти постачальника</h3>
				<button type="button" onclick="adminCloseModal()" class="w-10 h-10 flex items-center justify-center rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<p class="text-slate-500 text-sm font-medium">{ view.SupplierName }</p>
		</div>
		
		<div class="px-8 py-4 bg-slate-50 border-b border-slate-100 shrink-0">
			<div class="relative">
				<svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
				<input 
					type="text" 
					placeholder="Швидкий пошук інгредієнтів..." 
					class="w-full bg-white border border-slate-200 rounded-2xl pl-12 pr-4 py-3 text-sm focus:border-blue-500 focus:ring-4 focus:ring-blue-500/5 outline-none transition-all font-medium"
					onkeyup="filterIngredients(this.value)"
				/>
			</div>
		</div>

		<form hx-post={ fmt.Sprintf("/admin/suppliers/%d/ingredients", view.SupplierID) } hx-swap="none" class="flex-1 overflow-hidden flex flex-col">
			<div class="flex-1 overflow-y-auto px-8 py-6 scrollbar-thin">
				<div class="grid grid-cols-2 md:grid-cols-3 gap-3" id="ingredients-grid">
					for _, ing := range view.Ingredients {
						<label class="ingredient-card cursor-pointer group">
							<input 
								type="checkbox" 
								name="ingredient_ids[]" 
								value={ strconv.Itoa(ing.ID) }
								checked?={ view.SelectedIDs[ing.ID] }
								class="hidden peer"
							/>
							<div class="h-full border border-slate-200 rounded-xl p-3 flex flex-col gap-1 transition-all peer-checked:bg-blue-50 peer-checked:border-blue-300 peer-checked:ring-4 peer-checked:ring-blue-500/5 group-hover:border-slate-300">
								<div class="flex items-center justify-between">
									<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{ ing.UnitName }</span>
									<div class="w-4 h-4 rounded-full border-2 border-slate-200 peer-checked:bg-blue-500 peer-checked:border-blue-500 flex items-center justify-center transition-all bg-white overflow-hidden">
										<svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
										</svg>
									</div>
								</div>
								<span class="text-sm font-bold text-slate-700 leading-tight ing-name">{ ing.Name }</span>
							</div>
						</label>
					}
				</div>
			</div>
			
			<div class="px-8 py-6 border-t border-slate-100 bg-white shrink-0">
				<div class="flex gap-4">
					<button type="submit" class="flex-1 bg-slate-800 hover:bg-slate-900 text-white font-bold py-4 rounded-2xl shadow-xl transition-all active:scale-95">
						Зберегти асортимент
					</button>
					<button type="button" onclick="adminCloseModal()" class="px-8 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-4 rounded-2xl transition-all active:scale-95">
						Закрити
					</button>
				</div>
			</div>
		</form>
	</div>

	<script>
		function filterIngredients(query) {
			const q = query.toLowerCase();
			document.querySelectorAll('.ingredient-card').forEach(card => {
				const name = card.querySelector('.ing-name').textContent.toLowerCase();
				if (name.includes(q)) {
					card.style.display = 'block';
				} else {
					card.style.display = 'none';
				}
			});
		}
	</script>
}
