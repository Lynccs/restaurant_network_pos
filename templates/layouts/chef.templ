package layouts

templ ChefLayout(name string, workshop string, activePage string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="uk">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>RestaurantOS — Кухар</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="/static/js/htmx.min.js"></script>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="/static/css/flatpickr.min.css"/>
		<script src="/static/js/flatpickr.min.js"></script>
		<script src="/static/js/flatpickr.uk.js"></script>
		<style>
			* { font-family: 'IBM Plex Sans', sans-serif; }
			.mono { font-family: 'IBM Plex Mono', monospace; }
			.flatpickr-calendar { font-family: 'IBM Plex Sans', sans-serif; border: 1px solid #e2e8f0; border-radius: 0.75rem; box-shadow: 0 10px 25px -5px rgba(15,23,42,0.10), 0 4px 10px -6px rgba(15,23,42,0.08); background: #ffffff; }
			.flatpickr-months { background: #f8fafc; border-radius: 0.75rem 0.75rem 0 0; padding: 8px 4px 4px; border-bottom: 1px solid #e2e8f0; }
			.flatpickr-month { color: #1e293b; height: 36px; }
			.flatpickr-prev-month, .flatpickr-next-month { color: #64748b !important; fill: #64748b !important; }
			.flatpickr-prev-month:hover, .flatpickr-next-month:hover { color: #1e293b !important; fill: #1e293b !important; }
			.flatpickr-current-month { font-size: 0.875rem; font-weight: 600; color: #1e293b; }
			.flatpickr-current-month .flatpickr-monthDropdown-months { font-weight: 600; color: #1e293b; background: transparent; }
			.flatpickr-weekdays { background: #f8fafc; padding: 4px 0; }
			span.flatpickr-weekday { color: #94a3b8; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; background: transparent; }
			.flatpickr-day { border-radius: 0.5rem; color: #334155; font-size: 0.8125rem; border: none; height: 34px; line-height: 34px; max-width: 34px; }
			.flatpickr-day:hover, .flatpickr-day:focus { background: #eff6ff; color: #2563eb; border: none; }
			.flatpickr-day.today { background: #f1f5f9; color: #1e293b; font-weight: 600; border: none; }
			.flatpickr-day.today:hover { background: #eff6ff; color: #2563eb; }
			.flatpickr-day.selected, .flatpickr-day.selected:hover { background: #60a5fa; color: #fff; border: none; font-weight: 600; }
			.flatpickr-day.flatpickr-disabled, .flatpickr-day.flatpickr-disabled:hover { color: #cbd5e1; }
			.flatpickr-time { border-top: 1px solid #e2e8f0; background: #f8fafc; border-radius: 0 0 0.75rem 0.75rem; height: 44px; }
			.flatpickr-time input, .flatpickr-time .flatpickr-time-separator { font-family: 'IBM Plex Mono', monospace; color: #334155; font-size: 0.875rem; font-weight: 500; background: transparent; }
			.flatpickr-time input:hover, .flatpickr-time input:focus { background: #eff6ff; color: #2563eb; }
			.flatpickr-input.active { border-color: #60a5fa !important; outline: none !important; }
			.sidebar-item { transition: all 0.15s ease; }
			.sidebar-item:hover { background: rgba(255,255,255,0.08); }
			.sidebar-item.active { background: rgba(255,255,255,0.12); border-left: 2px solid #60a5fa; }
			@keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			.fade-in { animation: fadeIn 0.2s ease; }
			/* Custom thin scrollbar for the KDS board */
			.scrollbar-thin::-webkit-scrollbar { width: 4px; height: 4px; }
			.scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
			.scrollbar-thin::-webkit-scrollbar-thumb { background: #475569; border-radius: 2px; }
		</style>
		<!-- KDS Timer: ініціалізується при завантаженні і після кожного HTMX-свопу -->
		<script>
			function kdsUpdateTimers() {
				document.querySelectorAll('.kitchen-timer').forEach(function(el) {
					var start = parseInt(el.dataset.start);
					var limit = parseInt(el.dataset.limit) || 15;
					if (!start) return;
					var diff = Math.floor((Date.now() - start) / 1000);
					if (diff < 0) diff = 0;
					var hrs  = Math.floor(diff / 3600);
					var mins = Math.floor((diff % 3600) / 60);
					var secs = diff % 60;
					var pad  = function(n){ return String(n).padStart(2,'0'); };
					el.textContent = hrs > 0
						? hrs + ':' + pad(mins) + ':' + pad(secs)
						: pad(mins) + ':' + pad(secs);
					var card = el.closest('.dish-card-kds');
					if (card && mins >= limit && !card.dataset.timerOverdue) {
						card.dataset.timerOverdue = '1';
						el.classList.add('text-red-600', 'animate-pulse');
						el.classList.remove('text-slate-700', 'bg-slate-100', 'border-slate-200');
						el.classList.add('bg-red-50', 'border-red-300', 'border-2');
						card.classList.remove('border-slate-200', 'bg-white');
						card.classList.add('border-red-500', 'bg-red-100');
					}
				});
			}
			function kdsUpdateClock() {
				var el = document.getElementById('kds-clock');
				if (!el) return;
				var now = new Date();
				var pad = function(n){ return String(n).padStart(2,'0'); };
				el.textContent = now.toLocaleDateString('uk-UA') + ' ' +
					pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
			}
			function kdsInitTimers() {
				clearInterval(window._kdsTimer);
				window._kdsTimer = setInterval(function(){ kdsUpdateTimers(); kdsUpdateClock(); }, 1000);
				kdsUpdateTimers();
				kdsUpdateClock();
			}
			// ── Фільтри KDS ─────────────────────────────────────────────────
			if (!window.kdsFilters) {
				window.kdsFilters = { status:'all', table:'', chef:'all', workshop:'all', dish:'all', from:'', to:'' };
			}

			function kdsGetWorkshop(category) {
				if (category === 'Супи' || category === 'Основні') return 'Гарячий';
				if (category === 'Салати' || category === 'Десерти') return 'Холодний';
				return 'Закуски';
			}
			function parseTimeMin(v) {
				if (!v || !v.includes(':')) return null;
				var p = v.split(':');
				var h = parseInt(p[0], 10), m = parseInt(p[1], 10);
				return (isFinite(h) && isFinite(m)) ? h * 60 + m : null;
			}
			function kdsSetFilter(key, value) {
				var prev = window.kdsFilters[key];
				window.kdsFilters[key] = value;
				if (key === 'status') {
					var row = document.getElementById('kds-ready-date-row');
					if (value === 'ready') {
						if (row) {
							var inp = document.getElementById('kds-filter-ready-date');
							if (inp && !inp.value) inp.value = new Date().toISOString().split('T')[0];
							row.style.display = 'flex';
						}
						kdsApplyFilters(); // одразу фільтруємо поточну дошку
						kdsLoadReadyBoard(); // потім асинхронно завантажуємо архів
						return;
					} else {
						if (row) row.style.display = 'none';
						if (prev === 'ready') {
							// повертаємось до живої дошки через елемент з hx-get
							var liveBtn = document.getElementById('kds-live-reload');
							if (liveBtn) htmx.trigger(liveBtn, 'reload');
							return;
						}
					}
				}
				kdsApplyFilters();
			}
			function kdsLoadReadyBoard() {
				var inp = document.getElementById('kds-filter-ready-date');
				if (!inp || !inp.value) return;
				htmx.trigger(inp, 'ready-load');
			}
			function kdsClearFilters() {
				var wasReady = window.kdsFilters.status === 'ready';
				window.kdsFilters = { status:'all', table:'', chef:'all', workshop:'all', dish:'all', from:'', to:'' };
				var row = document.getElementById('kds-ready-date-row');
				if (row) row.style.display = 'none';
				var inp = document.getElementById('kds-filter-ready-date');
				if (inp) inp.value = '';
				kdsRestoreFilters();
				if (wasReady) {
					var liveBtn = document.getElementById('kds-live-reload');
					if (liveBtn) htmx.trigger(liveBtn, 'reload');
				} else {
					kdsApplyFilters();
				}
			}
			function kdsRestoreFilters() {
				var f = window.kdsFilters;
				['status','table','chef','workshop','dish','from','to'].forEach(function(key) {
					var el = document.getElementById('kds-filter-' + key);
					if (el) el.value = f[key];
				});
			}
			function kdsApplyFilters() {
				var f = window.kdsFilters;
				var sf = f.status;
				var fromMin = parseTimeMin(f.from), toMin = parseTimeMin(f.to);

				document.querySelectorAll('[id^="ticket-"]').forEach(function(ticketEl) {
					var ts    = ticketEl.dataset.ticketStatus || '';
					var tbl   = ticketEl.dataset.table || '';
					var crMs  = parseInt(ticketEl.dataset.createdMs || '0', 10);

					// Фільтр за № столу (рівень тікета)
					if (f.table && tbl !== f.table.trim()) { ticketEl.style.display = 'none'; return; }

					// Фільтр за часом створення замовлення (рівень тікета)
					if (fromMin !== null || toMin !== null) {
						if (!crMs) { ticketEl.style.display = 'none'; return; }
						var d = new Date(crMs);
						var crMin = d.getHours() * 60 + d.getMinutes();
						if (fromMin !== null && crMin < fromMin) { ticketEl.style.display = 'none'; return; }
						if (toMin   !== null && crMin > toMin)   { ticketEl.style.display = 'none'; return; }
					}

					// Фільтр за статусом (рівень тікета)
					var ticketOk = false;
					if      (sf === 'all')     ticketOk = (ts !== 'ready');
					else if (sf === 'overdue') ticketOk = (ts === 'overdue');
					else                       ticketOk = true; // уточнюється на рівні карток
					if (!ticketOk) { ticketEl.style.display = 'none'; return; }

					// Фільтрація карток страв
					var visible = 0;
					ticketEl.querySelectorAll('.dish-card-kds').forEach(function(card) {
						var cst = card.dataset.status || '';

						// Відповідність вкладці статусу
						var stOk = false;
						if      (sf === 'all')     stOk = true;
						else if (sf === 'overdue') stOk = (cst === 'new');
						else                       stOk = (cst === sf);
						if (!stOk) { card.style.display = 'none'; return; }

						// Страва
						if (f.dish !== 'all' && card.dataset.dish !== f.dish) { card.style.display = 'none'; return; }
						// Кухар
						if (f.chef !== 'all' && card.dataset.chef !== f.chef) { card.style.display = 'none'; return; }
						// Цех
						if (f.workshop !== 'all' && kdsGetWorkshop(card.dataset.category || '') !== f.workshop) { card.style.display = 'none'; return; }

						card.style.display = '';
						visible++;
					});

					ticketEl.style.display = visible > 0 ? '' : 'none';
				});

				var noResults = document.getElementById('kds-no-results');
				if (noResults) {
					var tickets = document.querySelectorAll('[id^="ticket-"]');
					var anyVisible = tickets.length > 0 && Array.from(tickets).some(function(el) {
						return el.style.display !== 'none';
					});
					noResults.style.display = anyVisible ? 'none' : '';
				}
			}

			function kdsOnBoardReady() { kdsInitTimers(); kdsRestoreFilters(); kdsApplyFilters(); }
			document.addEventListener('DOMContentLoaded', kdsOnBoardReady);
			document.addEventListener('htmx:afterSwap',  kdsOnBoardReady);

			// SSE: підписуємось на оновлення від сервера, при події оновлюємо дошку через HTMX
			// В архівному режимі ("ready") SSE не перезаписує дошку.
			(function() {
				function connectSSE() {
					var es = new EventSource('/chef/kitchen/events');
					es.onopen = function() {
						if (window.kdsFilters && window.kdsFilters.status === 'ready') return;
						var board = document.getElementById('kitchen-board');
						if (board) htmx.trigger(board, 'sse-refresh');
					};
					es.onmessage = function() {
						if (window.kdsFilters && window.kdsFilters.status === 'ready') return;
						if (window._kdsActionTime && Date.now() - window._kdsActionTime < 2000) return;
						var board = document.getElementById('kitchen-board');
						if (board) htmx.trigger(board, 'sse-refresh');
					};
					es.onerror = function() {
						es.close();
						setTimeout(connectSSE, 1000);
					};
				}
				connectSSE();
			})();
		</script>
	</head>
	<body class="overflow-hidden h-screen flex bg-slate-900">
		<!-- Sidebar -->
		<div class="w-56 bg-slate-900 flex-shrink-0 flex flex-col border-r border-slate-700/50">
			<!-- Logo -->
			<div class="px-4 py-4 border-b border-slate-700/50">
				<div class="flex items-center gap-2">
					<div class="w-7 h-7 bg-blue-500 rounded-md flex items-center justify-center flex-shrink-0">
						<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
						</svg>
					</div>
					<span class="text-white font-semibold text-sm tracking-tight">RestaurantOS</span>
				</div>
			</div>
			<!-- User info -->
			<div class="px-3 py-3 border-b border-slate-700/50">
				<div class="flex items-center gap-2.5">
					<div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
						if len([]rune(name)) > 0 {
							{ string([]rune(name)[:1]) }
						}
					</div>
					<div class="min-w-0">
						<p class="text-white text-xs font-medium truncate">{ name }</p>
						<p class="text-slate-400 text-xs">Кухар
							if workshop != "" {
								· { workshop }
							}
						</p>
					</div>
				</div>
			</div>
			<!-- Nav -->
			<nav class="flex-1 px-2 py-3 space-y-0.5">
				<a
					href="/chef/kitchen"
					class={ "sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs", templ.KV("active text-white", activePage == "kitchen") }
				>
					<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
					</svg>
					Монітор кухні
				</a>
				<a
					href="/chef/writeoff"
					class={ "sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs", templ.KV("active text-white", activePage == "writeoff") }
				>
					<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>
					Списані інгредієнти
				</a>
			</nav>
			<!-- Logout -->
			<div class="px-2 py-3 border-t border-slate-700/50">
				<form method="POST" action="/logout">
					<button
						type="submit"
						class="sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs"
					>
						<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
						</svg>
						Вийти
					</button>
				</form>
			</div>
		</div>
		<!-- Content area: flex-1, overflow-hidden — KDS сам керує скролом -->
		<div class="flex-1 overflow-hidden flex flex-col">
			@content
		</div>
		<!-- Контейнер для модальних вікон (завантажуються через HTMX) -->
		<div id="chef-modal"></div>
		<!-- Прихований тригер для повернення до живої дошки з архівного режиму -->
		<div
			id="kds-live-reload"
			style="display:none;"
			hx-get="/chef/kitchen/board"
			hx-target="#kitchen-board"
			hx-swap="outerHTML"
			hx-trigger="reload"
		></div>
	<div id="chef-error-toast" style="position:fixed;bottom:1.25rem;right:1.5rem;z-index:9999;background:#ef4444;color:#fff;padding:.6rem 1.25rem;border-radius:.5rem;font-size:.85rem;white-space:nowrap;box-shadow:0 4px 12px rgba(0,0,0,.35);opacity:0;transform:translateY(120%);transition:transform .3s ease,opacity .3s ease;pointer-events:none;">
		⚠ <span id="chef-error-toast-msg"></span>
	</div>
	<div id="toast-429" style="position:fixed;top:1.25rem;left:50%;transform:translateX(-50%) translateY(-120%);transition:transform .3s ease,opacity .3s ease;opacity:0;z-index:9999;background:#ea580c;color:#fff;padding:.6rem 1.25rem;border-radius:.5rem;font-size:.85rem;white-space:nowrap;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.35);">
		⚠ Забагато запитів — спробуйте пізніше
	</div>
	<script>
		(function() {
			var _toastTimer;
			function showToast429() {
				var t = document.getElementById('toast-429');
				if (!t) return;
				clearTimeout(_toastTimer);
				t.style.opacity = '1';
				t.style.transform = 'translateX(-50%) translateY(0)';
				_toastTimer = setTimeout(function() {
					t.style.opacity = '0';
					t.style.transform = 'translateX(-50%) translateY(-120%)';
				}, 3000);
			}
			var _chefErrTimer;
			function showChefErrorToast(msg) {
				var t = document.getElementById('chef-error-toast');
				var m = document.getElementById('chef-error-toast-msg');
				if (!t || !m) return;
				m.textContent = msg;
				clearTimeout(_chefErrTimer);
				t.style.opacity = '1';
				t.style.transform = 'translateY(0)';
				_chefErrTimer = setTimeout(function() {
					t.style.opacity = '0';
					t.style.transform = 'translateY(120%)';
				}, 3000);
			}
			document.body.addEventListener('htmx:responseError', function(e) {
				var status = e.detail.xhr.status;
				if (status === 429) {
					e.preventDefault();
					showToast429();
				} else {
					showChefErrorToast('Помилка сервера (' + status + '). Спробуйте ще раз.');
				}
			});
		})();
	</script>
	</body>
	</html>
}
