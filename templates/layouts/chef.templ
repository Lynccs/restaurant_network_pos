package layouts

templ ChefLayout(name string, activePage string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="uk">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>RestaurantOS — Кухар</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="/static/js/htmx.min.js"></script>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<style>
			* { font-family: 'IBM Plex Sans', sans-serif; }
			.mono { font-family: 'IBM Plex Mono', monospace; }
			.sidebar-item { transition: all 0.15s ease; }
			.sidebar-item:hover { background: rgba(255,255,255,0.08); }
			.sidebar-item.active { background: rgba(255,255,255,0.12); border-left: 2px solid #60a5fa; }
			@keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			.fade-in { animation: fadeIn 0.2s ease; }
			/* Custom thin scrollbar for the KDS board */
			.scrollbar-thin::-webkit-scrollbar { width: 4px; height: 4px; }
			.scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
			.scrollbar-thin::-webkit-scrollbar-thumb { background: #475569; border-radius: 2px; }
		</style>
		<!-- KDS Timer: ініціалізується при завантаженні і після кожного HTMX-свопу -->
		<script>
			function kdsUpdateTimers() {
				document.querySelectorAll('.kitchen-timer').forEach(function(el) {
					var start = parseInt(el.dataset.start);
					var limit = parseInt(el.dataset.limit) || 15;
					if (!start) return;
					var diff = Math.floor((Date.now() - start) / 1000);
					if (diff < 0) diff = 0;
					var mins = Math.floor(diff / 60);
					var secs = diff % 60;
					el.textContent = String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0');
					var card = el.closest('.dish-card-kds');
					if (card && mins >= limit && !card.dataset.timerOverdue) {
						card.dataset.timerOverdue = '1';
						el.classList.add('text-red-600', 'animate-pulse');
						el.classList.remove('text-slate-700', 'bg-slate-100', 'border-slate-200');
						el.classList.add('bg-red-50', 'border-red-300', 'border-2');
						card.classList.remove('border-slate-200', 'bg-white');
						card.classList.add('border-red-500', 'bg-red-100');
					}
				});
			}
			function kdsUpdateClock() {
				var el = document.getElementById('kds-clock');
				if (!el) return;
				var now = new Date();
				var pad = function(n){ return String(n).padStart(2,'0'); };
				el.textContent = now.toLocaleDateString('uk-UA') + ' ' +
					pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
			}
			function kdsInitTimers() {
				clearInterval(window._kdsTimer);
				window._kdsTimer = setInterval(function(){ kdsUpdateTimers(); kdsUpdateClock(); }, 1000);
				kdsUpdateTimers();
				kdsUpdateClock();
			}
			// ── Фільтри KDS ─────────────────────────────────────────────────
			if (!window.kdsFilters) {
				window.kdsFilters = { status:'all', table:'', chef:'all', workshop:'all', dish:'all', from:'', to:'' };
			}

			function kdsGetWorkshop(category) {
				if (category === 'Супи' || category === 'Основні') return 'Гарячий';
				if (category === 'Салати' || category === 'Десерти') return 'Холодний';
				return 'Закуски';
			}
			function parseTimeMin(v) {
				if (!v || !v.includes(':')) return null;
				var p = v.split(':');
				var h = parseInt(p[0], 10), m = parseInt(p[1], 10);
				return (isFinite(h) && isFinite(m)) ? h * 60 + m : null;
			}
			function kdsSetFilter(key, value) { window.kdsFilters[key] = value; kdsApplyFilters(); }
			function kdsClearFilters() {
				window.kdsFilters = { status:'all', table:'', chef:'all', workshop:'all', dish:'all', from:'', to:'' };
				kdsRestoreFilters();
				kdsApplyFilters();
			}
			function kdsRestoreFilters() {
				var f = window.kdsFilters;
				['status','table','chef','workshop','dish','from','to'].forEach(function(key) {
					var el = document.getElementById('kds-filter-' + key);
					if (el) el.value = f[key];
				});
			}
			function kdsApplyFilters() {
				var f = window.kdsFilters;
				var sf = f.status;
				var fromMin = parseTimeMin(f.from), toMin = parseTimeMin(f.to);

				document.querySelectorAll('[id^="ticket-"]').forEach(function(ticketEl) {
					var ts    = ticketEl.dataset.ticketStatus || '';
					var tbl   = ticketEl.dataset.table || '';
					var crMs  = parseInt(ticketEl.dataset.createdMs || '0', 10);

					// Фільтр за № столу (рівень тікета)
					if (f.table && tbl !== f.table.trim()) { ticketEl.style.display = 'none'; return; }

					// Фільтр за часом створення замовлення (рівень тікета)
					if (fromMin !== null || toMin !== null) {
						if (!crMs) { ticketEl.style.display = 'none'; return; }
						var d = new Date(crMs);
						var crMin = d.getHours() * 60 + d.getMinutes();
						if (fromMin !== null && crMin < fromMin) { ticketEl.style.display = 'none'; return; }
						if (toMin   !== null && crMin > toMin)   { ticketEl.style.display = 'none'; return; }
					}

					// Фільтр за статусом (рівень тікета)
					var ticketOk = false;
					if      (sf === 'all')     ticketOk = (ts !== 'ready');
					else if (sf === 'overdue') ticketOk = (ts === 'overdue');
					else                       ticketOk = true; // уточнюється на рівні карток
					if (!ticketOk) { ticketEl.style.display = 'none'; return; }

					// Фільтрація карток страв
					var visible = 0;
					ticketEl.querySelectorAll('.dish-card-kds').forEach(function(card) {
						var cst = card.dataset.status || '';

						// Відповідність вкладці статусу
						var stOk = false;
						if      (sf === 'all')     stOk = true;
						else if (sf === 'overdue') stOk = (cst === 'new');
						else                       stOk = (cst === sf);
						if (!stOk) { card.style.display = 'none'; return; }

						// Страва
						if (f.dish !== 'all' && card.dataset.dish !== f.dish) { card.style.display = 'none'; return; }
						// Кухар
						if (f.chef !== 'all' && card.dataset.chef !== f.chef) { card.style.display = 'none'; return; }
						// Цех
						if (f.workshop !== 'all' && kdsGetWorkshop(card.dataset.category || '') !== f.workshop) { card.style.display = 'none'; return; }

						card.style.display = '';
						visible++;
					});

					ticketEl.style.display = visible > 0 ? '' : 'none';
				});

				var noResults = document.getElementById('kds-no-results');
				if (noResults) {
					var tickets = document.querySelectorAll('[id^="ticket-"]');
					var anyVisible = tickets.length > 0 && Array.from(tickets).some(function(el) {
						return el.style.display !== 'none';
					});
					noResults.style.display = anyVisible ? 'none' : '';
				}
			}

			function kdsOnBoardReady() { kdsInitTimers(); kdsRestoreFilters(); kdsApplyFilters(); }
			document.addEventListener('DOMContentLoaded', kdsOnBoardReady);
			document.addEventListener('htmx:afterSwap',  kdsOnBoardReady);

			// SSE: підписуємось на оновлення від сервера, при події оновлюємо дошку через HTMX
			(function() {
				function connectSSE() {
					var es = new EventSource('/chef/kitchen/events');
					es.onopen = function() {
						// при (пере)підключенні одразу оновлюємо дошку — щоб не пропустити події, що надійшли під час розриву
						var board = document.getElementById('kitchen-board');
						if (board) htmx.trigger(board, 'sse-refresh');
					};
					es.onmessage = function() {
						var board = document.getElementById('kitchen-board');
						if (board) htmx.trigger(board, 'sse-refresh');
					};
					es.onerror = function() {
						es.close();
						setTimeout(connectSSE, 1000);
					};
				}
				connectSSE();
			})();
		</script>
	</head>
	<body class="overflow-hidden h-screen flex bg-slate-900">
		<!-- Sidebar -->
		<div class="w-56 bg-slate-900 flex-shrink-0 flex flex-col border-r border-slate-700/50">
			<!-- Logo -->
			<div class="px-4 py-4 border-b border-slate-700/50">
				<div class="flex items-center gap-2">
					<div class="w-7 h-7 bg-blue-500 rounded-md flex items-center justify-center flex-shrink-0">
						<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
						</svg>
					</div>
					<span class="text-white font-semibold text-sm tracking-tight">RestaurantOS</span>
				</div>
			</div>
			<!-- User info -->
			<div class="px-3 py-3 border-b border-slate-700/50">
				<div class="flex items-center gap-2.5">
					<div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
						if len([]rune(name)) > 0 {
							{ string([]rune(name)[:1]) }
						}
					</div>
					<div class="min-w-0">
						<p class="text-white text-xs font-medium truncate">{ name }</p>
						<p class="text-slate-400 text-xs">Кухар</p>
					</div>
				</div>
			</div>
			<!-- Nav -->
			<nav class="flex-1 px-2 py-3 space-y-0.5">
				<a
					href="/chef/kitchen"
					class={ "sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs", templ.KV("active text-white", activePage == "kitchen") }
				>
					<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
					</svg>
					Монітор кухні
				</a>
				<a
					href="/chef/writeoff"
					class={ "sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs", templ.KV("active text-white", activePage == "writeoff") }
				>
					<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>
					Списані інгредієнти
				</a>
			</nav>
			<!-- Logout -->
			<div class="px-2 py-3 border-t border-slate-700/50">
				<form method="POST" action="/logout">
					<button
						type="submit"
						class="sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs"
					>
						<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
						</svg>
						Вийти
					</button>
				</form>
			</div>
		</div>
		<!-- Content area: flex-1, overflow-hidden — KDS сам керує скролом -->
		<div class="flex-1 overflow-hidden flex flex-col">
			@content
		</div>
		<!-- Контейнер для модальних вікон (завантажуються через HTMX) -->
		<div id="chef-modal"></div>
	</body>
	</html>
}
