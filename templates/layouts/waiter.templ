package layouts

templ WaiterLayout(name string, activePage string, hasIssue bool, content templ.Component) {
	<!DOCTYPE html>
	<html lang="uk">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>RestaurantOS — Офіціант</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="/static/js/htmx.min.js"></script>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="/static/css/flatpickr.min.css"/>
		<style>
			* { font-family: 'IBM Plex Sans', sans-serif; }
			.mono { font-family: 'IBM Plex Mono', monospace; }
			.sidebar-item { transition: all 0.15s ease; }
			.sidebar-item:hover { background: rgba(255,255,255,0.08); }
			.sidebar-item.active { background: rgba(255,255,255,0.12); border-left: 2px solid #60a5fa; }
			@keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
			.fade-in { animation: fadeIn 0.2s ease; }
			@keyframes slideUp { from { opacity:0; transform:translateY(20px) scale(0.98); } to { opacity:1; transform:translateY(0) scale(1); } }
			.slide-up { animation: slideUp 0.22s ease; }
			/* Flatpickr overrides */
			.flatpickr-calendar { font-family: 'IBM Plex Sans', sans-serif; border: 1px solid #e2e8f0; border-radius: 0.75rem; box-shadow: 0 10px 25px -5px rgba(15,23,42,0.10), 0 4px 10px -6px rgba(15,23,42,0.08); background: #ffffff; }
			.flatpickr-months { background: #f8fafc; border-radius: 0.75rem 0.75rem 0 0; padding: 8px 4px 4px; border-bottom: 1px solid #e2e8f0; }
			.flatpickr-month { color: #1e293b; height: 36px; }
			.flatpickr-prev-month, .flatpickr-next-month { color: #64748b !important; fill: #64748b !important; }
			.flatpickr-prev-month:hover, .flatpickr-next-month:hover { color: #1e293b !important; fill: #1e293b !important; }
			.flatpickr-current-month { font-size: 0.875rem; font-weight: 600; color: #1e293b; }
			.flatpickr-current-month .flatpickr-monthDropdown-months { font-weight: 600; color: #1e293b; background: transparent; }
			.flatpickr-weekdays { background: #f8fafc; padding: 4px 0; }
			span.flatpickr-weekday { color: #94a3b8; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; background: transparent; }
			.flatpickr-day { border-radius: 0.5rem; color: #334155; font-size: 0.8125rem; border: none; height: 34px; line-height: 34px; max-width: 34px; }
			.flatpickr-day:hover, .flatpickr-day:focus { background: #eff6ff; color: #2563eb; border: none; }
			.flatpickr-day.today { background: #f1f5f9; color: #1e293b; font-weight: 600; border: none; }
			.flatpickr-day.today:hover { background: #eff6ff; color: #2563eb; }
			.flatpickr-day.selected, .flatpickr-day.selected:hover { background: #60a5fa; color: #fff; border: none; font-weight: 600; }
			.flatpickr-day.flatpickr-disabled, .flatpickr-day.flatpickr-disabled:hover { color: #cbd5e1; }
			.flatpickr-time { border-top: 1px solid #e2e8f0; background: #f8fafc; border-radius: 0 0 0.75rem 0.75rem; height: 44px; }
			.flatpickr-time input, .flatpickr-time .flatpickr-time-separator { font-family: 'IBM Plex Mono', monospace; color: #334155; font-size: 0.875rem; font-weight: 500; background: transparent; }
			.flatpickr-time input:hover, .flatpickr-time input:focus { background: #eff6ff; color: #2563eb; }
			.numInputWrapper:hover { background: transparent; }
			.numInputWrapper span.arrowUp:after { border-bottom-color: #64748b; }
			.numInputWrapper span.arrowDown:after { border-top-color: #64748b; }
			.flatpickr-input.active { border-color: #60a5fa !important; outline: none !important; }
		</style>
		<script src="/static/js/flatpickr.min.js"></script>
		<script src="/static/js/flatpickr.uk.js"></script>
	</head>
	<body class="bg-slate-50 overflow-hidden h-screen flex">
		<!-- Sidebar -->
		<div class="w-56 bg-slate-900 flex-shrink-0 flex flex-col">
			<!-- Logo -->
			<div class="px-4 py-4 border-b border-slate-700/50">
				<div class="flex items-center gap-2">
					<div class="w-7 h-7 bg-blue-500 rounded-md flex items-center justify-center flex-shrink-0">
						<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
						</svg>
					</div>
					<span class="text-white font-semibold text-sm tracking-tight">RestaurantOS</span>
				</div>
			</div>
			<!-- User info -->
			<div class="px-3 py-3 border-b border-slate-700/50">
				<div class="flex items-center gap-2.5">
					<div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
						if len(name) > 0 {
							{ string([]rune(name)[:1]) }
						}
					</div>
					<div class="min-w-0">
						<p class="text-white text-xs font-medium truncate">{ name }</p>
						<p class="text-slate-400 text-xs">Офіціант</p>
					</div>
				</div>
			</div>
			<!-- Nav -->
			<nav class="flex-1 px-2 py-3 space-y-0.5">
				<a
					href="/waiter/tables"
					class={ "sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs", templ.KV("active text-white", activePage == "tables") }
				>
					<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 6h4M10 18h4"/>
					</svg>
					Столики
				</a>
				<a
					href="/waiter/orders"
					class={ "sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs", templ.KV("active text-white", activePage == "orders") }
				>
					<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
					</svg>
					Замовлення
					<span id="orders-issue-badge" class={ "ml-auto w-2 h-2 rounded-full bg-red-500 animate-pulse flex-shrink-0", templ.KV("hidden", !hasIssue) }></span>
				</a>
			</nav>
			<!-- Logout -->
			<div class="px-2 py-3 border-t border-slate-700/50">
				<form method="POST" action="/logout">
					<button
						type="submit"
						class="sidebar-item w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-400 hover:text-white text-xs"
					>
						<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
						</svg>
						Вийти
					</button>
				</form>
			</div>
		</div>
		<!-- Main content -->
		<div class="flex-1 overflow-auto bg-slate-50">
			@content
		</div>
	<div id="toast-429" style="position:fixed;top:1.25rem;left:50%;transform:translateX(-50%) translateY(-120%);transition:transform .3s ease,opacity .3s ease;opacity:0;z-index:9999;background:#ea580c;color:#fff;padding:.6rem 1.25rem;border-radius:.5rem;font-size:.85rem;white-space:nowrap;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.35);">
		⚠ Забагато запитів — спробуйте пізніше
	</div>
	<!-- Waiter issue toast -->
	<div id="waiter-toast" style="display:none;position:fixed;top:1.25rem;right:1.5rem;z-index:9999;white-space:nowrap;background:#1e293b;color:#f8fafc;padding:.75rem 1rem;border-radius:.75rem;box-shadow:0 4px 16px rgba(0,0,0,.4);border-left:4px solid #ef4444;font-size:.85rem;align-items:center;gap:.75rem;">
		<span style="color:#f87171;font-weight:bold;flex-shrink:0;">⚠</span>
		<span id="waiter-toast-msg" style="flex:1;"></span>
		<button onclick="closeWaiterToast()" style="color:#94a3b8;background:none;border:none;cursor:pointer;font-size:1rem;line-height:1;flex-shrink:0;">✕</button>
	</div>
	<script>
		(function() {
			var _toastTimer;
			function showToast429() {
				var t = document.getElementById('toast-429');
				if (!t) return;
				clearTimeout(_toastTimer);
				t.style.opacity = '1';
				t.style.transform = 'translateX(-50%) translateY(0)';
				_toastTimer = setTimeout(function() {
					t.style.opacity = '0';
					t.style.transform = 'translateX(-50%) translateY(-120%)';
				}, 3000);
			}
			document.body.addEventListener('htmx:responseError', function(e) {
				var status = e.detail.xhr.status;
				if (status === 429) {
					e.preventDefault();
					showToast429();
				} else {
					showWaiterToast('Помилка сервера (' + status + '). Спробуйте ще раз.');
				}
			});

			// Waiter SSE
			function refreshWaiterContent() {
				if (document.getElementById('orders-list-wrapper'))
					htmx.ajax('GET', '/waiter/orders/list', { target: '#orders-list-wrapper', swap: 'innerHTML' });
				if (document.getElementById('tables-grid'))
					htmx.ajax('GET', '/waiter/tables/grid', { target: '#tables-grid', swap: 'outerHTML' });
			}

			function showWaiterToast(msg) {
				var t = document.getElementById('waiter-toast');
				var m = document.getElementById('waiter-toast-msg');
				if (!t || !m) return;
				m.textContent = msg;
				t.style.display = 'flex';
				clearTimeout(window._waiterToastTimer);
				window._waiterToastTimer = setTimeout(closeWaiterToast, 6000);
			}

			window.closeWaiterToast = function() {
				var t = document.getElementById('waiter-toast');
				if (t) t.style.display = 'none';
			};

			function connectWaiterSSE() {
				var es = new EventSource('/waiter/events');
				es.addEventListener('refresh', function() { refreshWaiterContent(); });
				es.addEventListener('issue', function(e) {
					try {
						var d = JSON.parse(e.data);
						showWaiterToast('Проблема на кухні: ' + d.dishName + ' (' + d.qty + ' порц.) — Стіл №' + d.tableNumber);
						var badge = document.getElementById('orders-issue-badge');
						if (badge) badge.classList.remove('hidden');
					} catch(_) {}
					refreshWaiterContent();
				});
				es.onerror = function() { es.close(); setTimeout(connectWaiterSSE, 2000); };
			}
			connectWaiterSSE();
		})();
	</script>
	</body>
	</html>
}
